nce.jpg\" width=\"1600\"/>\n                        <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(14,12,31,.08),rgba(14,12,31,.9))]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"conference card gradient overlay\">\n                        </div>\n                        <div class=\"absolute right-6 top-6 flex items-center gap-2 text-[11px] font-semibold text-[var(--gold-light)]\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"conference card count badge\">\n                            <i aria-hidden=\"true\" class=\"ti ti-presentation text-[17px]\" data-kid=\"1-2-3-1-2-1-3-1\" data-name=\"presentation icon\">\n                            </i>\n                            04 مؤتمرات رئيسية\n                        </div>\n                        <div class=\"absolute inset-x-6 bottom-6\" data-kid=\"1-2-3-1-2-1-4\" data-name=\"conference card text container\">\n                            <h3 class=\"bse-display text-[28px] font-bold text-white\" data-kid=\"1-2-3-1-2-1-4-1\" data-name=\"conference card title\">\n                                المؤتمرات\n                            </h3>\n                            <p class=\"mt-2 max-w-[430px] text-[13px] leading-relaxed text-white/72\" data-kid=\"1-2-3-1-2-1-4-2\" data-name=\"conference card description\">\n                                برامج علمية محكّمة، متحدثون متخصصون، ومعارض مصاحبة تجمع القطاع والمهنة.\n                            </p>\n                            <span class=\"mt-5 inline-flex items-center gap-2 text-[12px] font-bold text-[var(--gold-light)]\" data-kid=\"1-2-3-1-2-1-4-3\" data-name=\"conference card link\">\n                                اعرض المؤتمرات\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left text-[16px]\" data-kid=\"1-2-3-1-2-1-4-3-1\" data-name=\"arrow icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </a>\n                    <a class=\"group relative row-span-1 min-h-[156px] overflow-hidden rounded-xl bg-[var(--indigo)] lg:col-span-5\" data-kid=\"1-2-3-1-2-2\" data-name=\"services exhibition card\" href=\"#exhibitions\">\n                        <img alt=\"مساحة عرض في معرض هندسي\" class=\"bse-image absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"exhibition card image\" decoding=\"async\" height=\"1000\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-exhibition.jpg\" width=\"1600\"/>\n                        <div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(14,12,31,.88),rgba(14,12,31,.2))]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"exhibition card gradient overlay\">\n                        </div>\n                        <div class=\"absolute inset-y-0 right-0 flex w-[65%] flex-col justify-center px-6\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"exhibition card text container\">\n                            <p class=\"text-[11px] font-bold text-[var(--gold-light)]\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"exhibition card badge\">\n                                02 منصات مملوكة\n                            </p>\n                            <h3 class=\"bse-display mt-2 text-[23px] font-bold text-white\" data-kid=\"1-2-3-1-2-2-3-2\" data-name=\"exhibition card title\">\n                                المعارض\n                            </h3>\n                            <span class=\"mt-3 text-[12px] font-semibold text-white/80\" data-kid=\"1-2-3-1-2-2-3-3\" data-name=\"exhibition card link\">\n                                خطط لزيارتك\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left mr-1 text-[15px] text-[var(--gold-light)]\" data-kid=\"1-2-3-1-2-2-3-3-1\" data-name=\"arrow icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </a>\n                    <a class=\"group relative row-span-1 