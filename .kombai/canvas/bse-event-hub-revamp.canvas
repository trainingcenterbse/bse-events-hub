d-xl bg-[var(--indigo)] lg:col-span-5\" data-kid=\"1-2-3-1-2-4\" data-name=\"services sponsors card\" href=\"#sponsors\">\n                        <img alt=\"شركاء ورعاة في فعالية مهنية\" class=\"bse-image absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105\" data-kid=\"1-2-3-1-2-4-1\" data-name=\"sponsors card image\" decoding=\"async\" height=\"1000\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-sponsors.jpg\" width=\"1600\"/>\n                        <div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(14,12,31,.9),rgba(14,12,31,.22))]\" data-kid=\"1-2-3-1-2-4-2\" data-name=\"sponsors card gradient overlay\">\n                        </div>\n                        <div class=\"absolute inset-y-0 right-0 flex w-[65%] flex-col justify-center px-6\" data-kid=\"1-2-3-1-2-4-3\" data-name=\"sponsors card text container\">\n                            <p class=\"text-[11px] font-bold text-[var(--gold-light)]\" data-kid=\"1-2-3-1-2-4-3-1\" data-name=\"sponsors card badge\">\n                                شراكات قابلة للقياس\n                            </p>\n                            <h3 class=\"bse-display mt-2 text-[23px] font-bold text-white\" data-kid=\"1-2-3-1-2-4-3-2\" data-name=\"sponsors card title\">\n                                الرعاة والشركاء\n                            </h3>\n                            <span class=\"mt-3 text-[12px] font-semibold text-white/80\" data-kid=\"1-2-3-1-2-4-3-3\" data-name=\"sponsors card link\">\n                                اطلب ملف الرعاية\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left mr-1 text-[15px] text-[var(--gold-light)]\" data-kid=\"1-2-3-1-2-4-3-3-1\" data-name=\"arrow icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </a>\n                    <a class=\"group relative row-span-1 min-h-[156px] overflow-hidden rounded-xl bg-[var(--indigo)] lg:col-span-7\" data-kid=\"1-2-3-1-2-5\" data-name=\"services team card\" href=\"#about\">\n                        <img alt=\"فريق هندسي يعمل على تخطيط فعالية\" class=\"bse-image absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105\" data-kid=\"1-2-3-1-2-5-1\" data-name=\"team card image\" decoding=\"async\" height=\"1000\" loading=\"lazy\" src=\"/api/local/images/src/assets/team-work.jpg\" width=\"1600\"/>\n                        <div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(14,12,31,.94),rgba(14,12,31,.2))]\" data-kid=\"1-2-3-1-2-5-2\" data-name=\"team card gradient overlay\">\n                        </div>\n                        <div class=\"absolute inset-y-0 right-0 flex w-[58%] flex-col justify-center px-6\" data-kid=\"1-2-3-1-2-5-3\" data-name=\"team card text container\">\n                            <p class=\"text-[11px] font-bold text-[var(--gold-light)]\" data-kid=\"1-2-3-1-2-5-3-1\" data-name=\"team card badge\">\n                                فريق متعدد التخصصات\n                            </p>\n                            <h3 class=\"bse-display mt-2 text-[23px] font-bold text-white\" data-kid=\"1-2-3-1-2-5-3-2\" data-name=\"team card title\">\n                                فريق العمل والخدمات\n                            </h3>\n                            <span class=\"mt-3 text-[12px] font-semibold text-white/80\" data-kid=\"1-2-3-1-2-5-3-3\" data-name=\"team card link\">\n                                تعرّف على طريقة العمل\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left mr-1 text-[15px] text-[var(--gold-light)]\" data-kid=\"1-2-3-1-2-5-3-3-1\" data-name=\"arrow icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-white px-6 py-20 sm:py-24\" data-kid=\"1-2-4\" data-name=\"conferences detail section\" id=\"conferences\">\n            <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-2-4-1\" data-name=\"conferences detail inner container\">\n                <div class=\"grid items-center gap-10 lg:grid-cols-[1fr_1.15fr]\" data-kid=\"1-2-4-1-1\" data-name=\"conferences grid container\">\n                    <div class=\"relative min-h-[310px] overflow-hidden rounded-xl bg-[var(--indigo)]\" data-kid=\"1-2-4-1-1-1\" data-name=\"conferences featured image box\">\n                        <img alt=\"جلسة نقاشية في ندوة هندسية\" class=\"absolute inset-0 size-full object-cover\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"conferences featured image\" decoding=\"async\" height=\"1008\" loading=\"lazy\" src=\"/api/local/images/src/assets/seminar.jpg\" width=\"1600\"/>\n                        <div class=\"absolute inset-0 bg-[linear-gradient(180deg,transparent,rgba(14,12,31,.84))]\" data-kid=\"1-2-4-1-1-1-2\" data-name=\"conferences image overlay\">\n                        </div>\n                        <div class=\"absolute bottom-5 right-5 left-5 flex items-end justify-between gap-4 text-white\" data-kid=\"1-2-4-1-1-1-3\" data-name=\"conferences featured card text box\">\n                            <div data-kid=\"1-2-4-1-1-1-3-1\" data-name=\"conferences card text wrapper\">\n                                <p class=\"text-[11px] font-semibold text-[var(--gold-light)]\" data-kid=\"1-2-4-1-1-1-3-1-1\" data-name=\"conferences card status\">\n                                    النسخة القادمة\n                                </p>\n                                <p class=\"bse-display mt-1 text-[20px] font-bold\" data-kid=\"1-2-4-1-1-1-3-1-2\" data-name=\"conferences card title\">\n                                    إدارة الطاقة — الملتقى الخليجي 26\n                                </p>\n                            </div>\n                            <span class=\"grid size-10 shrink-0 place-items-center rounded-md border border-white/35 bg-white/10\" data-kid=\"1-2-4-1-1-1-3-2\" data-name=\"conferences arrow button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left text-[18px]\" data-kid=\"1-2-4-1-1-1-3-2-1\" data-name=\"arrow icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-4-1-1-2\" data-name=\"conferences content\">\n                        <p class=\"text-[11px] font-bold tracking-[.16em] text-[var(--gold)]\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"conferences small label\">\n                            منصة المعرفة\n                        </p>\n                        <h2 class=\"bse-display mt-3 text-[32px] font-bold leading-tight text-[var(--indigo)] sm:text-[40px]\" data-kid=\"1-2-4-1-1-2-2\" data-name=\"conferences heading\">\n                            مؤتمرات تبدأ من سؤال واضح وتنتهي بأثر قابل للقياس\n                        </h2>\n                        <p class=\"mt-5 max-w-[540px] text-[15px] leading-[1.9] text-[var(--ink-mute)]\" data-kid=\"1-2-4-1-1-2-3\" data-name=\"conferences description\">\n                            نستضيف برامج تجمع جمعيات المهندسين، صنّاع القرار، الجامعات، وشركات الطاقة والصناعة حول موضوعات عملية تخدم المنطقة.\n                        </p>\n                        <div class=\"mt-7 grid grid-cols-3 gap-4 border-t border-[var(--hairline)] pt-5\" data-kid=\"1-2-4-1-1-2-4\" data-name=\"conferences stats grid\">\n                            <div data-kid=\"1-2-4-1-1-2-4-1\" data-name=\"stat 1 wrapper\">\n                                <p class=\"bse-display text-[24px] font-bold text-[var(--bse-blue)]\" data-kid=\"1-2-4-1-1-2-4-1-1\" data-name=\"stat 1 value\">\n                                    26\n                                </p>\n                                <p class=\"mt-1 text-[11px] text-[var(--ink-mute)]\" data-kid=\"1-2-4-1-1-2-4-1-2\" data-name=\"stat 1 label\">\n                                    نسخة الملتقى الخليجي\n                                </p>\n                            </div>\n                            <div data-kid=\"1-2-4-1-1-2-4-2\" data-name=\"stat 2 wrapper\">\n                                <p class=\"bse-display text-[24px] font-bold text-[var(--bse-blue)]\" data-kid=\"1-2-4-1-1-2-4-2-1\" data-name=\"stat 2 value\">\n                                    40+\n                                </p>\n                                <p class=\"mt-1 text-[11px] text-[var(--ink-mute)]\" data-kid=\"1-2-4-1-1-2-4-2-2\" data-name=\"stat 2 label\">\n                                    متحدثًا ومتحدثة\n                                </p>\n                            </div>\n                            <div data-kid=\"1-2-4-1-1-2-4-3\" data-name=\"stat 3 wrapper\">\n                                <p class=\"bse-display text-[24px] font-bold text-[var(--bse-blue)]\" data-kid=\"1-2-4-1-1-2-4-3-1\" data-name=\"stat 3 value\">\n                                    3\n                                </p>\n                                <p class=\"mt-1 text-[11px] text-[var(--ink-mute)]\" data-kid=\"1-2-4-1-1-2-4-3-2\" data-name=\"stat 3 label\">\n                                    أيام من البرنامج\n                                </p>\n                            </div>\n                        </div>\n                        <a class=\"mt-8 inline-flex items-center gap-2 text-[13px] font-bold text-[var(--bse-blue)] underline decoration-[var(--gold)] decoration-2 underline-offset-8\" data-kid=\"1-2-4-1-1-2-5\" data-name=\"conferences explore link\" href=\"#explore\">\n                            اكتشف تفاصيل المؤتمرات\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left text-[17px]\" data-kid=\"1-2-4-1-1-2-5-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-t border-[var(--hairline)] bg-[var(--canvas-soft)] px-6 py-20 sm:py-24\" data-kid=\"1-2-5\" data-name=\"about process section\" id=\"about\">\n            <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-2-5-1\" data-name=\"about process inner container\">\n                <div class=\"grid gap-12 lg:grid-cols-[1.05fr_1fr] lg:items-start\" data-kid=\"1-2-5-1-1\" data-name=\"about grid container\">\n                    <div data-kid=\"1-2-5-1-1-1\" data-name=\"about process text column\">\n                        <p class=\"text-[11px] font-bold tracking-[.16em] text-[var(--gold)]\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"about small label\">\n                            طريقة العمل\n                        </p>\n                        <h2 class=\"bse-display mt-3 text-[32px] font-bold leading-tight text-[var(--indigo)] sm:text-[40px]\" data-kid=\"1-2-5-1-1-1-2\" data-name=\"about heading\">\n                            كيف نحول الفكرة إلى فعالية\n                        </h2>\n                        <p class=\"mt-4 max-w-[460px] text-[15px] leading-[1.9] text-[var(--ink-mute)]\" data-kid=\"1-2-5-1-1-1-3\" data-name=\"about description\">\n                            مسار واضح يربط التخطيط بالتنفيذ والتوثيق، حتى يعرف كل شريك ما سيحدث ومتى.\n                        </p>\n                        <div class=\"mt-9 grid grid-cols-2 gap-x-5 gap-y-7\" data-kid=\"1-2-5-1-1-1-4\" data-name=\"process steps grid\">\n                            <div class=\"border-t-2 border-[var(--gold)] pt-4\" data-kid=\"1-2-5-1-1-1-4-1\" data-name=\"process step 1\">\n                                <p class=\"bse-english text-[12px] font-bold text-[var(--gold)]\" data-kid=\"1-2-5-1-1-1-4-1-1\" data-name=\"step 1 label\">\n                                    01 / IDEA\n                                </p>\n                                <h3 class=\"bse-display mt-2 text-[18px] font-bold text-[var(--indigo)]\" data-kid=\"1-2-5-1-1-1-4-1-2\" data-name=\"step 1 title\">\n                                    الفكرة والهدف\n                                </h3>\n                                <p class=\"mt-2 text-[12px] leading-relaxed text-[var(--ink-mute)]\" data-kid=\"1-2-5-1-1-1-4-1-3\" data-name=\"step 1 desc\">\n                                    نحدد الجمهور، النتيجة، ونطاق المشروع قبل أي خطوة.\n                                </p>\n                            </div>\n                            <div class=\"border-t-2 border-[var(--indigo)] pt-4\" data-kid=\"1-2-5-1-1-1-4-2\" data-name=\"process step 2\">\n                                <p class=\"bse-english text-[12px] font-bold text-[var(--bse-blue)]\" data-kid=\"1-2-5-1-1-1-4-2-1\" data-name=\"step 2 label\">\n                                    02 / PROGRAMME\n                                </p>\n                                <h3 class=\"bse-display mt-2 text-[18px] font-bold text-[var(--indigo)]\" data-kid=\"1-2-5-1-1-1-4-2-2\" data-name=\"step 2 title\">\n                                    البرنامج والشركاء\n                                </h3>\n                                <p class=\"mt-2 text-[12px] leading-relaxed text-[var(--ink-mute)]\" data-kid=\"1-2-5-1-1-1-4-2-3\" data-name=\"step 2 desc\">\n                                    نبني المحتوى، نستقطب المتحدثين، وننسق الشركاء.\n                                </p>\n                            </div>\n                            <div class=\"border-t-2 border-[var(--indigo)] pt-4\" data-kid=\"1-2-5-1-1-1-4-3\" data-name=\"process step 3\">\n                                <p class=\"bse-english text-[12px] font-bold text-[var(--bse-blue)]\" data-kid=\"1-2-5-1-1-1-4-3-1\" data-name=\"step 3 label\">\n                                    03 / DELIVERY\n                                </p>\n                                <h3 class=\"bse-display mt-2 text-[18px] font-bold text-[var(--indigo)]\" data-kid=\"1-2-5-1-1-1-4-3-2\" data-name=\"step 3 title\">\n                                    التنفيذ في الموقع\n                                </h3>\n                                <p class=\"mt-2 text-[12px] leading-relaxed text-[var(--ink-mute)]\" data-kid=\"1-2-5-1-1-1-4-3-3\" data-name=\"step 3 desc\">\n                                    تشغيل، تسجيل، سلامة، وتجربة حضور متسقة في كل نقطة.\n                                </p>\n                            </div>\n                            <div class=\"border-t-2 border-[var(--gold)] pt-4\" data-kid=\"1-2-5-1-1-1-4-4\" data-name=\"process step 4\">\n                                <p class=\"bse-english text-[12px] font-bold text-[var(--gold)]\" data-kid=\"1-2-5-1-1-1-4-4-1\" data-name=\"step 4 label\">\n                                    04 / REPORT\n                                </p>\n                                <h3 class=\"bse-display mt-2 text-[18px] font-bold text-[var(--indigo)]\" data-kid=\"1-2-5-1-1-1-4-4-2\" data-name=\"step 4 title\">\n                                    التقرير والأثر\n                                </h3>\n                                <p class=\"mt-2 text-[12px] leading-relaxed text-[var(--ink-mute)]\" data-kid=\"1-2-5-1-1-1-4-4-3\" data-name=\"step 4 desc\">\n                                    نوثق النتائج ونحوّل ما تعلمناه إلى نسخة أقوى.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"relative overflow-hidden rounded-xl bg-[var(--indigo)] p-3\" data-kid=\"1-2-5-1-1-2\" data-name=\"about process hero card\">\n                        <img alt=\"فريق تنظيم يراجع مخطط فعالية\" class=\"h-[390px] w-full rounded-lg object-cover\" data-kid=\"1-2-5-1-1-2-1\" data-name=\"about process card image\" decoding=\"async\" height=\"1000\" loading=\"lazy\" src=\"/api/local/images/src/assets/team-work.jpg\" width=\"1600\"/>\n                        <div class=\"absolute bottom-7 right-7 left-7 rounded-lg border border-white/20 bg-[var(--navy)]/82 p-5 text-white backdrop-blur-sm\" data-kid=\"1-2-5-1-1-2-2\" data-name=\"about process info box\">\n                            <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-5-1-1-2-2-1\" data-name=\"info box header wrapper\">\n                                <span class=\"bse-english text-[10px] font-semibold text-[var(--gold-light)]\" data-kid=\"1-2-5-1-1-2-2-1-1\" data-name=\"info box label\">\n                                    ONE DELIVERY TEAM\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left text-[18px] text-[var(--gold-light)]\" data-kid=\"1-2-5-1-1-2-2-1-2\" data-name=\"info box icon\">\n                                </i>\n                            </div>\n                            <p class=\"bse-display mt-3 text-[22px] font-bold\" data-kid=\"1-2-5-1-1-2-2-2\" data-name=\"info box headline\">\n                                من الفكرة إلى التقرير الختامي\n                            </p>\n                            <p class=\"mt-2 text-[12px] leading-relaxed text-white/65\" data-kid=\"1-2-5-1-1-2-2-3\" data-name=\"info box subtext\">\n                                إدارة تشغيلية وفنية وإعلامية في مسار واحد، مع نقطة تواصل واضحة لكل شريك.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[var(--teal)] px-6 py-20 text-white sm:py-24\" data-kid=\"1-2-6\" data-name=\"call-to-action section\" id=\"events\">\n            <div class=\"mx-auto flex max-w-[980px] flex-col items-center text-center\" data-kid=\"1-2-6-1\" data-name=\"cta inner container\">\n                <p class=\"text-[11px] font-bold tracking-[.16em] text-[var(--gold-light)]\" data-kid=\"1-2-6-1-1\" data-name=\"cta small label\">\n                    الختام يبدأ من محادثة\n                </p>\n                <h2 class=\"bse-display mt-4 max-w-[700px] text-[32px] font-bold leading-tight sm:text-[42px]\" data-kid=\"1-2-6-1-2\" data-name=\"cta headline\">\n                    هل لديك فعالية تستحق منصة أكبر؟\n                </h2>\n                <p class=\"mt-5 max-w-[590px] text-[15px] leading-[1.9] text-white/70\" data-kid=\"1-2-6-1-3\" data-name=\"cta description\">\n                    شاركنا الفكرة، وسنساعدك على تحويلها إلى تجربة واضحة للحضور وشراكة ذات أثر للراعي.\n                </p>\n                <a class=\"mt-8 inline-flex min-h-11 items-center gap-2 rounded-md bg-white px-6 py-3 text-[13px] font-bold text-[var(--teal)] hover:bg-[var(--gold-light)]\" data-kid=\"1-2-6-1-4\" data-name=\"cta button\" href=\"#contact\">\n                    ابدأ محادثة\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left text-[17px]\" data-kid=\"1-2-6-1-4-1\" data-name=\"arrow icon\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[var(--navy)] px-6 text-white\" data-kid=\"1-3\" data-name=\"footer section\" id=\"contact\">\n        <div class=\"mx-auto grid max-w-[1200px] gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]\" data-kid=\"1-3-1\" data-name=\"footer grid container\">\n            <div data-kid=\"1-3-1-1\" data-name=\"footer branding column\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1\" data-name=\"footer logo wrapper\">\n                    <span class=\"grid size-11 place-items-center rounded-md bg-white p-1\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer logo container\">\n                        <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"size-full rounded-sm object-contain\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"footer logo image\" decoding=\"async\" height=\"44\" loading=\"lazy\" src=\"/api/local/images/public/favicon.png\" width=\"44\"/>\n                    </span>\n                    <div data-kid=\"1-3-1-1-1-2\" data-name=\"footer brand name wrapper\">\n                        <p class=\"bse-display text-[18px] font-bold\" data-kid=\"1-3-1-1-1-2-1\" data-name=\"footer brand name\">\n                            BSE Event\n                        </p>\n                        <p class=\"mt-1 text-[10px] text-white/55\" data-kid=\"1-3-1-1-1-2-2\" data-name=\"footer brand subtitle\">\n                            جمعية المهندسين البحرينية\n                        </p>\n                    </div>\n                </div>\n                <p class=\"mt-5 max-w-[390px] text-[12px] leading-[1.9] text-white/60\" data-kid=\"1-3-1-1-2\" data-name=\"footer brand description\">\n                    قسم إدارة الفعاليات والمؤتمرات والمعارض — نبني منصات هندسية تجمع الرعاة والعارضين والحضور في مكان واحد.\n                </p>\n            </div>\n            <div data-kid=\"1-3-1-2\" data-name=\"footer links column\">\n                <h3 class=\"text-[11px] font-bold tracking-[.14em] text-[var(--gold-light)]\" data-kid=\"1-3-1-2-1\" data-name=\"footer links header\">\n                    روابط سريعة\n                </h3>\n                <div class=\"mt-4 grid grid-cols-2 gap-x-5 gap-y-3 text-[12px] text-white/65\" data-kid=\"1-3-1-2-2\" data-name=\"footer links grid\">\n                    <a class=\"hover:text-[var(--gold-light)]\" data-kid=\"1-3-1-2-2-1\" data-name=\"link about\" href=\"#about\">\n                        من نحن\n                    </a>\n                    <a class=\"hover:text-[var(--gold-light)]\" data-kid=\"1-3-1-2-2-2\" data-name=\"link conferences\" href=\"#conferences\">\n                        المؤتمرات\n                    </a>\n                    <a class=\"hover:text-[var(--gold-light)]\" data-kid=\"1-3-1-2-2-3\" data-name=\"link exhibitions\" href=\"#explore\">\n                        المعارض\n                    </a>\n                    <a class=\"hover:text-[var(--gold-light)]\" data-kid=\"1-3-1-2-2-4\" data-name=\"link events\" href=\"#events\">\n                        الفعاليات\n                    </a>\n                    <a class=\"hover:text-[var(--gold-light)]\" data-kid=\"1-3-1-2-2-5\" data-name=\"link sponsors\" href=\"#sponsors\">\n                        الرعاة\n                    </a>\n                    <a class=\"hover:text-[var(--gold-light)]\" data-kid=\"1-3-1-2-2-6\" data-name=\"link top\" href=\"#top\">\n                        العودة للأعلى\n                    </a>\n                </div>\n            </div>\n            <div data-kid=\"1-3-1-3\" data-name=\"footer contact column\">\n                <h3 class=\"text-[11px] font-bold tracking-[.14em] text-[var(--gold-light)]\" data-kid=\"1-3-1-3-1\" data-name=\"footer contact header\">\n                    تواصل معنا\n                </h3>\n                <div class=\"mt-4 space-y-3 text-[12px] text-white/65\" data-kid=\"1-3-1-3-2\" data-name=\"footer contact list\">\n                    <p class=\"flex items-start gap-2\" data-kid=\"1-3-1-3-2-1\" data-name=\"footer address item\">\n                        <i aria-hidden=\"true\" class=\"ti ti-map-pin mt-0.5 text-[15px] text-[var(--gold-light)]\" data-kid=\"1-3-1-3-2-1-1\" data-name=\"map icon\">\n                        </i>\n                        مبنى الجمعية، الجفير، مملكة البحرين\n                    </p>\n                    <p class=\"flex items-center gap-2\" data-kid=\"1-3-1-3-2-2\" data-name=\"footer phone item\">\n                        <i aria-hidden=\"true\" class=\"ti ti-phone text-[15px] text-[var(--gold-light)]\" data-kid=\"1-3-1-3-2-2-1\" data-name=\"phone icon\">\n                        </i>\n                        <span data-kid=\"1-3-1-3-2-2-2\" data-name=\"phone number text\" dir=\"ltr\">\n                            +973 1772 7100\n                        </span>\n                    </p>\n                    <p class=\"flex items-center gap-2\" data-kid=\"1-3-1-3-2-3\" data-name=\"footer email item\">\n                        <i aria-hidden=\"true\" class=\"ti ti-mail text-[15px] text-[var(--gold-light)]\" data-kid=\"1-3-1-3-2-3-1\" data-name=\"mail icon\">\n                        </i>\n                        events@bse.bh\n                    </p>\n                </div>\n            </div>\n        </div>\n        <div class=\"border-t border-white/10 py-5 text-center text-[10px] text-white/40\" data-kid=\"1-3-2\" data-name=\"footer copyright bar\">\n            © 2026 BSE Event — جميع الحقوق محفوظة لجمعية المهندسين البحرينية\n        </div>\n    </footer>\n</div>\n",
