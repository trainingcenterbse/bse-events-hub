(--blue-soft)]\" data-kid=\"1-2-3-1-3-4-1-2-3-2-1\" href=\"#conference-program\">\n                                            افتح صفحة المؤتمر\n                                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left text-[17px]\" data-kid=\"1-2-3-1-3-4-1-2-3-2-1-1\">\n                                            </i>\n                                        </a>\n                                        <span class=\"font-display text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-3-1-3-4-1-2-3-2-2\">\n                                            100+ بحث علمي\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </article>\n                </div>\n                <div class=\"mt-8 rounded-xl border border-dashed border-[var(--hairline)] bg-white px-6 py-10 text-center\" data-dynamic=\"true\" data-kid=\"1-2-3-1-4\" data-name=\"empty search results state container\" data-reason=\"visibility toggled by filter script\" hidden=\"\" id=\"emptyState\">\n                    <span class=\"icon-box mx-auto\" data-kid=\"1-2-3-1-4-1\">\n                        <i aria-hidden=\"true\" class=\"ti ti-search-off text-[21px]\" data-kid=\"1-2-3-1-4-1-1\">\n                        </i>\n                    </span>\n                    <h3 class=\"font-display mt-4 text-lg font-bold text-[var(--navy)]\" data-kid=\"1-2-3-1-4-2\">\n                        لم نعثر على مؤتمر مطابق\n                    </h3>\n                    <p class=\"mt-2 text-sm text-[var(--muted)]\" data-kid=\"1-2-3-1-4-3\">\n                        جرّب كلمة بحث مختلفة أو أعد عرض جميع المؤتمرات.\n                    </p>\n                    <button class=\"font-display mt-5 min-h-10 rounded-md bg-[var(--navy)] px-4 text-[13px] font-bold text-white\" data-kid=\"1-2-3-1-4-4\" id=\"clear-filters\" type=\"button\">\n                        عرض جميع المؤتمرات\n                    </button>\n                </div>\n                <div class=\"mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--hairline)] pt-5\" data-kid=\"1-2-3-1-5\">\n                    <p class=\"font-display text-[12px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-2-3-1-5-1\">\n                        السنة على كل غلاف تشير إلى النسخة أو الدورة المعروضة.\n                    </p>\n                    <a class=\"font-display inline-flex items-center gap-2 text-[13px] font-bold text-[var(--blue)] hover:text-[var(--gold)]\" data-kid=\"1-2-3-1-5-2\" href=\"#contact\">\n                        تحتاج ملفًا لمؤتمر سابق؟\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left text-[16px]\" data-kid=\"1-2-3-1-5-2-1\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[var(--teal)] py-20 text-white sm:py-24\" data-kid=\"1-2-4\" id=\"conference-program\">\n            <div class=\"mx-auto flex max-w-[1160px] flex-col gap-8 px-6 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-2-4-1\">\n                <div class=\"max-w-[650px]\" data-kid=\"1-2-4-1-1\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-4-1-1-1\">\n                        <span class=\"h-px w-12 bg-[var(--gold)]\" data-kid=\"1-2-4-1-1-1-1\">\n                        </span>\n                        <p class=\"font-ui text-[11px] font-semibold uppercase tracking-[.2em] text-[var(--gold)]\" data-kid=\"1-2-4-1-1-1-2\">\n                            PARTNERSHIPS\n                        </p>\n                    </div>\n                    <h2 class=\"font-display mt-4 text-[34px] font-extrabold leading-[1.2] tracking-[-.03em] sm:text-[42px]\" data-kid=\"1-2-4-1-1-2\">\n                        هل لديك مؤتمر قادم؟\n                    </h2>\n                    <p class=\"mt-4 max-w-[620px] text-[16px] leading-[1.8] text-white/70\" data-kid=\"1-2-4-1-1-3\">\n                        نحوّل الشراكة إلى برنامج واضح، حضور مؤثر، وتجربة منظمة من الدعوة حتى التقرير الختامي.\n                    </p>\n                </div>\n                <a class=\"font-display inline-flex min-h-12 shrink-0 items-center gap-2 rounded-md bg-white px-6 text-[14px] font-bold text-[var(--teal)] shadow-sm hover:bg-[var(--gold-soft)]\" data-kid=\"1-2-4-1-2\" href=\"#contact\">\n                    ناقش فرص الشراكة\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left text-[18px]\" data-kid=\"1-2-4-1-2-1\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[var(--navy)] text-white\" data-kid=\"1-3\" id=\"contact\">\n        <div class=\"mx-auto grid max-w-[1160px] gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr]\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1\">\n                    <span class=\"grid size-12 place-items-center rounded-full bg-white p-1\" data-kid=\"1-3-1-1-1-1\">\n                        <img alt=\"جمعية المهندسين البحرينية\" class=\"size-full rounded-full object-cover\" data-kid=\"1-3-1-1-1-1-1\" decoding=\"async\" height=\"48\" loading=\"lazy\" src=\"/api/local/images/public/favicon.png\" width=\"48\"/>\n                    </span>\n                    <div data-kid=\"1-3-1-1-1-2\">\n                        <p class=\"font-display text-[19px] font-extrabold\" data-kid=\"1-3-1-1-1-2-1\">\n                            BSE Event\n                        </p>\n                        <p class=\"font-display mt-0.5 text-[11px] text-white/60\" data-kid=\"1-3-1-1-1-2-2\">\n                            جمعية المهندسين البحرينية\n                        </p>\n                    </div>\n                </div>\n                <p class=\"mt-5 max-w-[400px] text-[13px] leading-[1.9] text-white/65\" data-kid=\"1-3-1-1-2\">\n                    قسم إدارة الفعاليات والمؤتمرات والمعارض — ننظم منصات هندسية متخصصة تجمع الرعاة والعارضين والحضور.\n                </p>\n            </div>\n            <div data-kid=\"1-3-1-2\">\n                <h3 class=\"font-display text-[13px] font-bold text-[var(--gold)]\" data-kid=\"1-3-1-2-1\">\n                    روابط سريعة\n                </h3>\n                <ul class=\"mt-4 space-y-2.5 text-[13px]\" data-kid=\"1-3-1-2-2\">\n                    <li data-kid=\"1-3-1-2-2-1\">\n                        <a class=\"footer-link\" data-kid=\"1-3-1-2-2-1-1\" href=\"#about\">\n                            من نحن\n                        </a>\n                    </li>\n                    <li data-kid=\"1-3-1-2-2-2\">\n                        <a class=\"footer-link\" data-kid=\"1-3-1-2-2-2-1\" href=\"#conference-list\">\n                            المؤتمرات\n                        </a>\n                    </li>\n                    <li data-kid=\"1-3-1-2-2-3\">\n                        <a class=\"footer-link\" data-kid=\"1-3-1-2-2-3-1\" href=\"#events\">\n                            الفعاليات\n                        </a>\n                    </li>\n                    <li data-kid=\"1-3-1-2-2-4\">\n                        <a class=\"footer-link\" data-kid=\"1-3-1-2-2-4-1\" href=\"#contact\">\n                            الرعاة والشراكات\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"1-3-1-3\">\n                <h3 class=\"font-display text-[13px] font-bold text-[var(--gold)]\" data-kid=\"1-3-1-3-1\">\n                    تواصل معنا\n                </h3>\n                <ul class=\"mt-4 space-y-3 text-[13px] text-white/70\" data-kid=\"1-3-1-3-2\">\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-3-1-3-2-1\">\n                        <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[16px] text-[var(--gold)]\" data-kid=\"1-3-1-3-2-1-1\">\n                        </i>\n                        مبنى الجمعية، الجفير، مملكة البحرين\n                    </li>\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-3-1-3-2-2\">\n                        <i aria-hidden=\"true\" class=\"ti ti-phone text-[16px] text-[var(--gold)]\" data-kid=\"1-3-1-3-2-2-1\">\n                        </i>\n                        <span data-kid=\"1-3-1-3-2-2-2\" dir=\"ltr\">\n                            +973 1772 7100\n                        </span>\n                    </li>\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-3-1-3-2-3\">\n                        <i aria-hidden=\"true\" class=\"ti ti-mail text-[16px] text-[var(--gold)]\" data-kid=\"1-3-1-3-2-3-1\">\n                        </i>\n                        events@bse.bh\n                    </li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"border-t border-white/10 py-5 text-center font-display text-[11px] text-white/45\" data-kid=\"1-3-2\">\n            © 2025 BSE Event — جميع الحقوق محفوظة لجمعية المهندسين البحرينية\n        </div>\n    </footer>\n</div>\n<script>\n    (() => {\n    const rows = Array.from(document.querySelectorAll('[data-conference-row]'));\n    const tabs = Array.from(document.querySelectorAll('[data-filter]'));\n    const search = document.getElementById('conference-search');\n    const count = document.getElementById('result-count');\n    const empty = document.getElementById('emptyState');\n    const clear = document.getElementById('clear-filters');\n    let activeFilter = 'all';\n\n    const update = () => {\n      const query = (search?.value || '').trim().toLowerCase();\n      let visible = 0;\n      rows.forEach((row) => {\n        const matchesStatus = activeFilter === 'all' || row.dataset.status === activeFilter;\n        const matchesQuery = !query || (row.dataset.search || '').toLowerCase().includes(query);\n        const show = matchesStatus && matchesQuery;\n        row.hidden = !show;\n        row.classList.toggle('is-muted', activeFilter === 'past' && row.dataset.status === 'past');\n        if (show) visible += 1;\n      });\n      if (count) count.textContent = String(visible);\n      if (empty) empty.hidden = visible !== 0;\n    };\n\n    tabs.forEach((tab) => tab.addEventListener('click', () => {\n      activeFilter = tab.dataset.filter || 'all';\n      tabs.forEach((item) => {\n        const selected = item === tab;\n        item.classList.toggle('tab-active', selected);\n        item.classList.toggle('tab-idle', !selected);\n        item.setAttribute('aria-selected', String(selected));\n      });\n      update();\n    }));\n    search?.addEventListener('input', update);\n    clear?.addEventListener('click', () => {\n      if (search) search.value = '';\n      activeFilter = 'all';\n      tabs.forEach((item, index) => {\n        const selected = index === 0;\n        item.classList.toggle('tab-active', selected);\n        item.classList.toggle('tab-idle', !selected);\n        item.setAttribute('aria-selected', String(selected));\n      });\n      update();\n    });\n    update();\n  })();\n</script>\n",
