    },
    "var_1dca5b2642bd": {
      "type": "variant",
      "label": "الرئيسية — المخطط المؤسسي",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  :root {\n    --navy: #0e0c1f;\n    --indigo: #1b1938;\n    --bse-blue: #123c8b;\n    --teal: #0e3030;\n    --teal-mid: #155555;\n    --gold: #d5a84b;\n    --gold-light: #f2d084;\n    --canvas: #ffffff;\n    --canvas-soft: #fafaf8;\n    --ink: #292827;\n    --ink-mute: #73706d;\n    --ink-faint: #9a9794;\n    --hairline: #e8e4dd;\n    --font-body: 'IBM Plex Sans Arabic', 'Inter', ui-sans-serif, system-ui, sans-serif;\n    --font-display: 'Cairo', 'Inter', ui-sans-serif, system-ui, sans-serif;\n  }\n  .bse-display { font-family: var(--font-display); font-variation-settings: \"wght\" 700; }\n  .bse-body { font-family: var(--font-body); }\n  .bse-english { font-family: 'Inter', sans-serif; letter-spacing: .08em; }\n  .bse-rule { background: linear-gradient(90deg, transparent, var(--gold), transparent); }\n  .bse-image { filter: saturate(.9) contrast(1.04); }\n</style>\n<div class=\"bse-body min-h-screen overflow-x-hidden bg-[var(--canvas)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\">\n    <header class=\"h-[76px] border-b border-[var(--hairline)] bg-white\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex h-full max-w-[1200px] items-center gap-7 px-6\" data-kid=\"1-1-1\" data-name=\"header inner content wrapper\">\n            <a aria-label=\"BSE Event — الصفحة الرئيسية\" class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand link\" href=\"#top\">\n                <span class=\"grid size-11 place-items-center rounded-md border border-[var(--gold)]/60 bg-[var(--canvas-soft)] p-1\" data-kid=\"1-1-1-1-1\" data-name=\"logo container\">\n                    <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"size-full rounded-sm object-contain\" data-kid=\"1-1-1-1-1-1\" data-name=\"BSE logo image\" decoding=\"async\" height=\"44\" loading=\"lazy\" src=\"/api/local/images/public/favicon.png\" width=\"44\"/>\n                </span>\n                <span class=\"leading-none\" data-kid=\"1-1-1-1-2\" data-name=\"brand text wrapper\">\n                    <span class=\"bse-display block text-[18px] font-bold text-[var(--indigo)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        BSE Event\n                    </span>\n                    <span class=\"mt-1 block text-[10px] font-semibold text-[var(--ink-mute)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        قسم الفعاليات والمؤتمرات والمعارض\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"hidden flex-1 items-center justify-center gap-1 xl:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"rounded-md bg-[var(--canvas-soft)] px-3.5 py-2 text-[13px] font-semibold text-[var(--indigo)]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link home\" href=\"#top\">\n                    الرئيسية\n                </a>\n                <a class=\"rounded-md px-3.5 py-2 text-[13px] font-semibold text-[var(--ink-mute)] hover:bg-[var(--canvas-soft)] hover:text-[var(--indigo)]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link about\" href=\"#about\">\n                    من نحن\n                </a>\n                <a class=\"rounded-md px-3.5 py-2 text-[13px] font-semibold text-[var(--ink-mute)] hover:bg-[var(--canvas-soft)] hover:text-[var(--indigo)]\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link conferences\" href=\"#conferences\">\n                    المؤتمرات\n                </a>\n                <a class=\"rounded-md px-3.5 py-2 text-[13px] font-semibold text-[var(--ink-mute)] hover:bg-[var(--canvas-soft)] hover:text-[var(--indigo)]\" data-kid=\"1-1-1-2-4\" data-name=\"navigation link exhibitions\" href=\"#explore\">\n                    المعارض\n                </a>\n                <a class=\"rounded-md px-3.5 py-2 text-[13px] font-semibold text-[var(--ink-mute)] hover:bg-[var(--canvas-soft)] hover:text-[var(--indigo)]\" data-kid=\"1-1-1-2-5\" data-name=\"navigation link events\" href=\"#events\">\n                    الفعاليات\n                </a>\n                <a class=\"rounded-md px-3.5 py-2 text-[13px] font-semibold text-[var(--ink-mute)] hover:bg-[var(--canvas-soft)] hover:text-[var(--indigo)]\" data-kid=\"1-1-1-2-6\" data-name=\"navigation link sponsors\" href=\"#contact\">\n                    الرعاة\n                </a>\n            </nav>\n            <div class=\"ms-auto flex shrink-0 items-center gap-2\" data-kid=\"1-1-1-3\" data-name=\"header action buttons container\">\n                <button aria-label=\"تغيير اللغة\" class=\"hidden items-center gap-1.5 rounded-md px-2.5 py-2 text-[11px] font-semibold text-[var(--indigo)] sm:flex\" data-kid=\"1-1-1-3-1\" data-name=\"language toggle button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-world text-[15px]\" data-kid=\"1-1-1-3-1-1\" data-name=\"world icon\">\n                    </i>\n                    <span class=\"bse-english\" data-kid=\"1-1-1-3-1-2\" data-name=\"language name text\">\n                        ENGLISH\n                    </span>\n                </button>\n                <a class=\"inline-flex min-h-10 items-center gap-2 rounded-md bg-[var(--gold)] px-4 py-2.5 text-[12px] font-bold text-[var(--navy)] shadow-sm hover:bg-[var(--gold-light)]\" data-kid=\"1-1-1-3-2\" data-name=\"sponsor call-to-action button\" href=\"#contact\">\n                    كن راعياً\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"1-1-1-3-2-1\" data-name=\"arrow-up-right icon\">\n                    </i>\n                </a>\n                <button aria-label=\"فتح القائمة\" class=\"grid size-10 place-items-center rounded-md border border-[var(--hairline)] text-[var(--indigo)] xl:hidden\" data-kid=\"1-1-1-3-3\" data-name=\"menu toggle button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-menu-2 text-[19px]\" data-kid=\"1-1-1-3-3-1\" data-name=\"hamburger menu icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section class=\"[direction:ltr] grid min-h-[570px] grid-cols-1 lg:grid-cols-2\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"relative min-h-[360px] overflow-hidden lg:min-h-0\" data-kid=\"1-2-1-1\" data-name=\"hero background image container\">\n                <img alt=\"قاعة مؤتمر هندسي وحضور على المسرح — صورة من أرشيف BSE\" class=\"bse-image absolute inset-0 size-full object-cover\" data-kid=\"1-2-1-1-1\" data-name=\"hero background image\" decoding=\"async\" height=\"1088\" loading=\"eager\" src=\"/api/local/images/src/assets/hero-conference.jpg\" width=\"1920\"/>\n                <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(14,12,31,.12),rgba(14,12,31,.76))]\" data-kid=\"1-2-1-1-2\" data-name=\"hero overlay gradient\">\n                </div>\n                <div class=\"absolute inset-x-0 bottom-0 p-7 text-right text-white sm:p-10\" data-kid=\"1-2-1-1-3\" data-name=\"hero badge text container\">\n                    <div class=\"flex items-center gap-3 text-[11px] font-semibold text-white/80\" data-kid=\"1-2-1-1-3-1\" data-name=\"hero badge label wrapper\">\n                        <span class=\"h-px w-9 bg-[var(--gold)]\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"hero badge rule line\">\n                        </span>\n                        <span class=\"bse-english\" data-kid=\"1-2-1-1-3-1-2\" data-name=\"hero badge label\">\n                            ENGINEERING PLATFORMS / BAHRAIN\n                        </span>\n                    </div>\n                    <p class=\"mt-3 max-w-sm text-sm leading-relaxed text-white/80\" data-kid=\"1-2-1-1-3-2\" data-name=\"hero badge description\">\n                        منصة تجمع المعرفة، الشراكات، واللقاء المهني في قلب المشهد الهندسي البحريني.\n                    </p>\n                </div>\n                <div class=\"absolute right-7 top-7 grid size-12 place-items-center rounded-md border border-white/30 bg-[var(--navy)]/35 text-[var(--gold-light)] backdrop-blur-sm\" data-kid=\"1-2-1-1-4\" data-name=\"hero icon button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-grid text-[22px]\" data-kid=\"1-2-1-1-4-1\" data-name=\"grid icon\">\n                    </i>\n                </div>\n            </div>\n            <div class=\"[direction:rtl] flex flex-col justify-center bg-[var(--indigo)] px-7 py-14 text-white sm:px-12 lg:px-16\" data-kid=\"1-2-1-2\" data-name=\"hero content section\">\n                <div class=\"max-w-[520px]\" data-kid=\"1-2-1-2-1\" data-name=\"hero copy wrapper\">\n                    <div class=\"flex flex-wrap items-center gap-3 text-[11px] font-semibold text-[var(--gold-light)]\" data-kid=\"1-2-1-2-1-1\" data-name=\"hero top badge wrapper\">\n                        <span class=\"bse-english\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"hero top badge label\">\n                            BSE EVENT\n                        </span>\n                        <span class=\"h-px w-10 bg-[var(--gold)]\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"hero top badge rule\">\n                        </span>\n                        <span data-kid=\"1-2-1-2-1-1-3\" data-name=\"hero top badge text\">\n                            40 عاماً من الأثر\n                        </span>\n                    </div>\n                    <h1 class=\"bse-display mt-6 max-w-[500px] text-[38px] font-bold leading-[1.16] tracking-[-.02em] text-white sm:text-[48px]\" data-kid=\"1-2-1-2-1-2\" data-name=\"hero main headline\">\n                        منصة البحرين للمعرفة الهندسية واللقاء المهني\n                    </h1>\n                    <p class=\"mt-6 max-w-[470px] text-[16px] leading-[1.9] text-white/72\" data-kid=\"1-2-1-2-1-3\" data-name=\"hero subheadline\">\n                        نصمم مؤتمرات ومعارض وفعاليات تجعل الخبرة الهندسية قابلة للقاء، التعلم، والشراكة — من الفكرة إلى التقرير الختامي.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap items-center gap-3\" data-kid=\"1-2-1-2-1-4\" data-name=\"hero cta buttons wrapper\">\n                        <a class=\"inline-flex min-h-11 items-center gap-2 rounded-md bg-[var(--gold)] px-5 py-3 text-[13px] font-bold text-[var(--navy)] hover:bg-[var(--gold-light)]\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"hero primary cta button\" href=\"#conferences\">\n                            استكشف المؤتمرات\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-left text-[17px]\" data-kid=\"1-2-1-2-1-4-1-1\" data-name=\"arrow-up-left icon\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex min-h-11 items-center gap-2 rounded-md border border-white/30 px-5 py-3 text-[13px] font-semibold text-white hover:border-white/60 hover:bg-white/10\" data-kid=\"1-2-1-2-1-4-2\" data-name=\"hero secondary cta button\" href=\"#about\">\n                            تعرّف على خدماتنا\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-left text-[16px]\" data-kid=\"1-2-1-2-1-4-2-1\" data-name=\"arrow-left icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"mt-12 flex items-center gap-4 border-t border-white/15 pt-5 text-[11px] text-white/55\" data-kid=\"1-2-1-2-1-5\" data-name=\"hero location badge\">\n                        <span class=\"grid size-8 place-items-center rounded-sm border border-white/20 text-[var(--gold-light)]\" data-kid=\"1-2-1-2-1-5-1\" data-name=\"map pin icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[16px]\" data-kid=\"1-2-1-2-1-5-1-1\" data-name=\"map pin icon\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-2-1-2-1-5-2\" data-name=\"location address text\">\n                            مملكة البحرين · جمعية المهندسين البحرينية\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"أرقام BSE Event\" class=\"bg-[var(--navy)] text-white\" data-kid=\"1-2-2\" data-name=\"stats section\">\n            <div class=\"mx-auto grid max-w-[1200px] grid-cols-2 divide-x divide-white/10 px-6 py-8 [direction:ltr] sm:grid-cols-4 sm:py-9\" data-kid=\"1-2-2-1\" data-name=\"stats grid container\">\n                <div class=\"[direction:rtl] px-4 text-center sm:px-7\" data-kid=\"1-2-2-1-1\" data-name=\"stat item container 1\">\n                    <p class=\"bse-display text-[32px] font-bold leading-none text-[var(--gold-light)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"stat 1 value\">\n                        40+\n                    </p>\n                    <p class=\"mt-3 text-[11px] text-white/60\" data-kid=\"1-2-2-1-1-2\" data-name=\"stat 1 label\">\n                        عاماً من العمل الهندسي\n                    </p>\n                </div>\n                <div class=\"[direction:rtl] px-4 text-center sm:px-7\" data-kid=\"1-2-2-1-2\" data-name=\"stat item container 2\">\n                    <p class=\"bse-display text-[32px] font-bold leading-none text-[var(--gold-light)]\" data-kid=\"1-2-2-1-2-1\" data-name=\"stat 2 value\">\n                        120+\n                    </p>\n                    <p class=\"mt-3 text-[11px] text-white/60\" data-kid=\"1-2-2-1-2-2\" data-name=\"stat 2 label\">\n                  