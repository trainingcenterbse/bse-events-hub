div class=\"sticky top-6 space-y-4\" data-kid=\"1-2-3-1-2-1\">\n                        <div class=\"border border-[var(--hairline)] bg-white p-6 shadow-[0_8px_24px_rgba(0,0,0,.06)]\" data-kid=\"1-2-3-1-2-1-1\">\n                            <div class=\"flex items-center justify-between border-b border-[var(--hairline)] pb-4\" data-kid=\"1-2-3-1-2-1-1-1\">\n                                <h2 class=\"display text-[21px] font-bold text-[var(--navy)]\" data-kid=\"1-2-3-1-2-1-1-1-1\">\n                                    تفاصيل الفعالية\n                                </h2>\n                                <span class=\"ui rounded-full bg-[var(--gold-soft)] px-2.5 py-1 text-[10px] font-bold text-[var(--navy)]\" data-kid=\"1-2-3-1-2-1-1-1-2\">\n                                    BSE 2026\n                                </span>\n                            </div>\n                            <dl class=\"mt-5 space-y-5\" data-kid=\"1-2-3-1-2-1-1-2\">\n                                <div class=\"flex gap-3\" data-kid=\"1-2-3-1-2-1-1-2-1\">\n                                    <i class=\"ti ti-calendar-event mt-0.5\" data-kid=\"1-2-3-1-2-1-1-2-1-1\" style=\"color:#c9a65a;width:20px;height:20px;font-size:20px\">\n                                    </i>\n                                    <div data-kid=\"1-2-3-1-2-1-1-2-1-2\">\n                                        <dt class=\"text-[11px] text-[var(--faint)]\" data-kid=\"1-2-3-1-2-1-1-2-1-2-1\">\n                                            التاريخ\n                                        </dt>\n                                        <dd class=\"mt-1 text-[13px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-3-1-2-1-1-2-1-2-2\">\n                                            سنوياً\n                                        </dd>\n                                    </div>\n                                </div>\n                                <div class=\"flex gap-3\" data-kid=\"1-2-3-1-2-1-1-2-2\">\n                 