    "var_d70542f17357": {
      "type": "variant",
      "label": "تفاصيل فعالية — يوم المهندس",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  .bse-page {\n    --navy: #1b1938;\n    --navy-deep: #0e0c1f;\n    --gold: #c9a65a;\n    --gold-soft: #f3e6c5;\n    --ink: #292827;\n    --muted: #73706d;\n    --faint: #9a9794;\n    --canvas: #ffffff;\n    --canvas-soft: #fafaf8;\n    --violet: #c9b4fa;\n    --teal: #0e3030;\n    --teal-mid: #155555;\n    --hairline: #e8e4dd;\n    direction: rtl;\n    background: var(--canvas);\n    color: var(--ink);\n    font-family: 'IBM Plex Sans Arabic', sans-serif;\n  }\n  .bse-page .display { font-family: 'Cairo', sans-serif; letter-spacing: -0.025em; }\n  .bse-page .ui { font-family: 'Inter', 'IBM Plex Sans Arabic', sans-serif; }\n  .bse-page .hero-wash { background: linear-gradient(128deg, rgba(14,12,31,.98), rgba(27,25,56,.95) 58%, rgba(27,25,56,.76)); }\n  .bse-page .photo-wash { background: linear-gradient(90deg, rgba(14,12,31,.25), rgba(14,12,31,.92)); }\n  .bse-page .blueprint { background-image: linear-gradient(rgba(201,166,90,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(201,166,90,.1) 1px, transparent 1px); background-size: 30px 30px; }\n  .bse-page .mini-map { background-color: #eef1f7; background-image: linear-gradient(32deg, transparent 44%, rgba(27,25,56,.15) 45%, rgba(27,25,56,.15) 47%, transparent 48%), linear-gradient(122deg, transparent 42%, rgba(201,166,90,.55) 43%, rgba(201,166,90,.55) 45%, transparent 46%), linear-gradient(rgba(27,25,56,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(27,25,56,.08) 1px, transparent 1px); background-size: 100% 100%, 100% 100%, 16px 16px, 16px 16px; }\n  .bse-page .tab-button[aria-selected='true'] { background: var(--gold); color: var(--navy-deep); border-color: var(--gold); }\n  .bse-page [hidden] { display: none; }\n</style>\n<div class=\"bse-page min-h-screen overflow-hidden\" data-kid=\"1\" dir=\"rtl\">\n    <header class=\"border-b border-[var(--hairline)] bg-white\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-[82px] max-w-[1180px] items-center gap-5 px-6 lg:px-0\" data-kid=\"1-1-1\">\n            <a aria-label=\"BSE Event\" class=\"flex shrink-0 items-center gap-3 no-underline\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span class=\"grid h-12 w-12 place-items-center rounded-[8px] border border-[var(--gold)]/50 bg-[var(--canvas-soft)] p-1.5 shadow-sm\" data-kid=\"1-1-1-1-1\">\n                    <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"h-full w-full rounded-full object-cover\" data-kid=\"1-1-1-1-1-1\" decoding=\"async\" height=\"48\" loading=\"lazy\" src=\"/api/local/images/public/favicon.png\" width=\"48\"/>\n                </span>\n                <span class=\"leading-tight\" data-kid=\"1-1-1-1-2\">\n                    <span class=\"display block text-[20px] font-extrabold text-[var(--navy)]\" data-kid=\"1-1-1-1-2-1\">\n                        BSE Event\n                    </span>\n                    <span class=\"block text-[11px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-1-2-2\">\n                        قسم الفعاليات والمؤتمرات والمعارض\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"mx-auto hidden items-center gap-1 lg:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"rounded-[8px] px-3 py-2 text-[13px] font-semibold text-[var(--muted)] no-underline hover:bg-[#f5f3ee] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-1\" href=\"#about\">\n                    عن الفعالية\n                </a>\n                <a class=\"rounded-[8px] px-3 py-2 text-[13px] font-semibold text-[var(--muted)] no-underline hover:bg-[#f5f3ee] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-2\" href=\"#highlights\">\n                    المميزات\n                </a>\n                <a class=\"rounded-[8px] px-3 py-2 text-[13px] font-semibold text-[var(--muted)] no-underline hover:bg-[#f5f3ee] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-3\" href=\"#schedule\">\n                    البرنامج\n                </a>\n                <a class=\"rounded-[8px] px-3 py-2 text-[13px] font-semibold text-[var(--muted)] no-underline hover:bg-[#f5f3ee] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-4\" href=\"#location\">\n                    الموقع\n                </a>\n            </nav>\n            <div class=\"ms-auto flex items-center gap-2\" data-kid=\"1-1-1-3\">\n                <button class=\"hidden h-10 items-center gap-2 rounded-[8px] border border-[var(--hairline)] bg-white px-3 text-[12px] font-semibold text-[var(--navy)] sm:inline-flex\" data-kid=\"1-1-1-3-1\">\n                    <i class=\"ti ti-language\" data-kid=\"1-1-1-3-1-1\" style=\"color:#1b1938;width:16px;height:16px;font-size:16px\">\n                    </i>\n                    English\n                </button>\n                <a class=\"ui inline-flex h-10 items-center justify-center rounded-[8px] bg-[var(--navy)] px-4 text-[12px] font-bold text-white no-underline shadow-sm\" data-kid=\"1-1-1-3-2\" href=\"#rsvp\">\n                    كن راعياً\n                </a>\n                <button aria-label=\"فتح القائمة\" class=\"grid h-10 w-10 place-items-center rounded-[8px] border border-[var(--hairline)] text-[var(--navy)] lg:hidden\" data-kid=\"1-1-1-3-3\">\n                    <i class=\"ti ti-menu-2\" data-kid=\"1-1-1-3-3-1\" style=\"color:#1b1938;width:20px;height:20px;font-size:20px\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"hero-wash relative min-h-[460px] overflow-hidden text-white\" data-kid=\"1-2-1\">\n            <div class=\"absolute inset-y-0 start-0 w-full lg:w-1/2\" data-kid=\"1-2-1-1\">\n                <img alt=\"حفل تكريم المهندسين — تصوير BSE Event\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-1-1-1\" decoding=\"async\" height=\"1088\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-sponsors.jpg\" width=\"1920\"/>\n                <div class=\"photo-wash absolute inset-0\" data-kid=\"1-2-1-1-2\">\n                </div>\n                <div class=\"absolute inset-0 opacity-40 blueprint\" data-kid=\"1-2-1-1-3\">\n                </div>\n            </div>\n            <div class=\"relative mx-auto flex min-h-[460px] max-w-[1180px] flex-col lg:flex-row\" data-kid=\"1-2-1-2\">\n                <div class=\"order-1 flex w-full flex-col justify-center px-6 py-14 lg:w-1/2 lg:px-14 lg:py-12\" data-kid=\"1-2-1-2-1\">\n                    <div class=\"mb-5 flex flex-wrap items-center gap-3 text-[12px] font-semibold text-white/60\" data-kid=\"1-2-1-2-1-1\">\n                        <span data-kid=\"1-2-1-2-1-1-1\">\n                            الفعاليات\n                        </span>\n                        <i class=\"ti ti-chevron-left\" data-kid=\"1-2-1-2-1-1-2\" style=\"color:#c9a65a;width:14px;height:14px;font-size:14px\">\n                        </i>\n                        <span data-kid=\"1-2-1-2-1-1-3\">\n                            فعاليات رئيسية\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2-1-2\">\n                        <span class=\"inline-flex items-center gap-2 rounded-full border border-[var(--gold)] bg-[var(--gold)] px-3 py-1.5 text-[11px] font-bold text-[var(--navy-deep)]\" data-kid=\"1-2-1-2-1-2-1\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--navy-deep)]\" data-kid=\"1-2-1-2-1-2-1-1\">\n                            </span>\n                            قادم\n                        </span>\n                        <span class=\"text-[11px] font-semibold tracking-[.12em] text-white/50\" data-kid=\"1-2-1-2-1-2-2\">\n                            BSE SIGNATURE EVENT\n                        </span>\n                    </div>\n                    <h1 class=\"display mt-6 max-w-[560px] text-[42px] font-extrabold leading-[1.08] sm:text-[54px]\" data-kid=\"1-2-1-2-1-3\">\n                        يوم المهندس البحريني\n                    </h1>\n                    <p class=\"mt-5 max-w-[550px] text-[16px] leading-[1.9] text-white/70\" data-kid=\"1-2-1-2-1-4\">\n                        احتفالية وطنية سنوية تكرّم المهندس البحريني وتبرز إنجازاته في مشاريع المملكة الكبرى، مع معرض مصاحب وجلسات حوارية.\n                    </p>\n                    <div class=\"mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-[13px] text-white/75\" data-kid=\"1-2-1-2-1-5\">\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-1-5-1\">\n                            <i class=\"ti ti-calendar-event\" data-kid=\"1-2-1-2-1-5-1-1\" style=\"color:#c9a65a;width:17px;height:17px;font-size:17px\">\n                            </i>\n                            سنوياً\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-1-5-2\">\n                            <i class=\"ti ti-users\" data-kid=\"1-2-1-2-1-5-2-1\" style=\"color:#c9a65a;width:17px;height:17px;font-size:17px\">\n                            </i>\n                            800+ حاضر\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-1-5-3\">\n                            <i class=\"ti ti-award\" data-kid=\"1-2-1-2-1-5-3-1\" style=\"color:#c9a65a;width:17px;height:17px;font-size:17px\">\n                            </i>\n                            30+ مكرّم\n                        </span>\n                    </div>\n                    <div class=\"mt-8 flex flex-wrap gap-3\" data-kid=\"1-2-1-2-1-6\">\n                        <a class=\"ui inline-flex h-12 items-center justify-center gap-2 rounded-[8px] bg-[var(--gold)] px-5 text-[13px] font-bold text-[var(--navy-deep)] no-underline shadow-sm\" data-kid=\"1-2-1-2-1-6-1\" href=\"#rsvp\">\n                            سجّل اهتمامك\n                            <i class=\"ti ti-arrow-left\" data-kid=\"1-2-1-2-1-6-1-1\" style=\"color:#0e0c1f;width:17px;height:17px;font-size:17px\">\n                            </i>\n                        </a>\n                        <a class=\"ui inline-flex h-12 items-center justify-center gap-2 rounded-[8px] border border-white/35 bg-transparent px-5 text-[13px] font-semibold text-white no-underline hover:bg-white/10\" data-kid=\"1-2-1-2-1-6-2\" href=\"#location\">\n                            <i class=\"ti ti-map-pin\" data-kid=\"1-2-1-2-1-6-2-1\" style=\"color:#c9a65a;width:17px;height:17px;font-size:17px\">\n                            </i>\n                            عرض الموقع\n                        </a>\n                    </div>\n                </div>\n                <div class=\"order-2 min-h-[260px] w-full lg:w-1/2\" data-kid=\"1-2-1-2-2\">\n                </div>\n            </div>\n            <div class=\"absolute bottom-0 end-0 h-px w-full bg-[var(--gold)]/60\" data-kid=\"1-2-1-3\">\n            </div>\n        </section>\n        <nav aria-label=\"روابط الصفحة\" class=\"border-b border-[var(--hairline)] bg-white\" data-kid=\"1-2-2\">\n            <div class=\"mx-auto flex max-w-[1120px] items-center gap-5 overflow-x-auto px-6 py-4 text-[12px] font-semibold text-[var(--muted)] lg:px-0\" data-kid=\"1-2-2-1\">\n                <a class=\"whitespace-nowrap text-[var(--navy)] no-underline\" data-kid=\"1-2-2-1-1\" href=\"#about\">\n                    عن الفعالية\n                </a>\n                <span class=\"h-4 w-px bg-[var(--hairline)]\" data-kid=\"1-2-2-1-2\">\n                </span>\n                <a class=\"whitespace-nowrap no-underline hover:text-[var(--navy)]\" data-kid=\"1-2-2-1-3\" href=\"#highlights\">\n                    أبرز ما يميزها\n                </a>\n                <span class=\"h-4 w-px bg-[var(--hairline)]\" data-kid=\"1-2-2-1-4\">\n                </span>\n                <a class=\"whitespace-nowrap no-underline hover:text-[var(--navy)]\" data-kid=\"1-2-2-1-5\" href=\"#schedule\">\n                    البرنامج\n                </a>\n                <span class=\"h-4 w-px bg-[var(--hairline)]\" data-kid=\"1-2-2-1-6\">\n                </span>\n                <a class=\"whitespace-nowrap no-underline hover:text-[var(--navy)]\" data-kid=\"1-2-2-1-7\" href=\"#location\">\n                    الموقع\n                </a>\n                <span class=\"ms-auto hidden whitespace-nowrap text-[11px] text-[var(--faint)] sm:inline\" data-dynamic=\"true\" data-kid=\"1-2-2-1-8\" data-name=\"last update date\" data-reason=\"date text updated to current year by server-side render\">\n                    آخر تحديث: 2026\n                </span>\n            </div>\n        </nav>\n        <section class=\"bg-[var(--canvas-soft)] px-6 py-16 lg:px-0 lg:py-20\" data-kid=\"1-2-3\">\n            <div class=\"mx-auto flex max-w-[1120px] flex-col gap-12 lg:flex-row\" data-kid=\"1-2-3-1\">\n                <div class=\"order-1 min-w-0 flex-1 lg:w-2/3\" data-kid=\"1-2-3-1-1\">\n                    <section class=\"scroll-mt-24\" data-kid=\"1-2-3-1-1-1\" id=\"about\">\n                        <p class=\"ui text-[11px] font-bold tracking-[.15em] text-[var(--gold)]\" data-kid=\"1-2-3-1-1-1-1\">\n                            01 / عن الفعالية\n                        </p>\n                        <h2 class=\"display mt-3 text-[32px] font-extrabold leading-tight text-[var(--navy)] sm:text-[40px]\" data-kid=\"1-2-3-1-1-1-2\">\n                            تكريم المهنة التي تبني المملكة\n                        </h2>\n                        <div class=\"mt-5 h-1 w-16 bg-[var(--gold)]\" data-kid=\"1-2-3-1-1-1-3\">\n                        </div>\n                        <p class=\"mt-7 max-w-[720px] text-[16px] leading-[2] text-[var(--muted)]\" data-kid=\"1-2-3-1-1-1-4\">\n                            يوم المهندس البحريني هو أبرز فعالية وطنية ينظمها قسم الفعاليات، ويُقام بحضور رسمي رفيع لتكريم المهندسين والمهندسات المتميزين وإبراز إسهام المهنة الهندسية في مشاريع البنية التحتية والطاقة والإسكان في المملكة. يشمل البرنامج حفل تكريم، ومعرضاً لمشاريع هندسية وطنية، وجلسة حوارية مع قيادات القطاع، ولقاءات تواصل مهني للحضور والرعاة.\n                        </p>\n                    </section>\n                    <div class=\"mt-10 grid grid-cols-3 gap-3 border-y border-[var(--hairline)] py-6\" data-kid=\"1-2-3-1-1-2\">\n                        <div class=\"border-s border-[var(--hairline)] pe-4 first:border-0\" data-kid=\"1-2-3-1-1-2-1\">\n                            <div class=\"ui text-[30px] font-bold text-[var(--navy)]\" data-kid=\"1-2-3-1-1-2-1-1\">\n                                800\n                                <span class=\"text-[var(--gold)]\" data-kid=\"1-2-3-1-1-2-1-1-1\">\n                                    +\n                                </span>\n                            </div>\n                            <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-3-1-1-2-1-2\">\n                                حاضر ومتخصص\n                            </p>\n                        </div>\n                        <div class=\"border-s border-[var(--hairline)] pe-4\" data-kid=\"1-2-3-1-1-2-2\">\n                            <div class=\"ui text-[30px] font-bold text-[var(--navy)]\" data-kid=\"1-2-3-1-1-2-2-1\">\n                                30\n                                <span class=\"text-[var(--gold)]\" data-kid=\"1-2-3-1-1-2-2-1-1\">\n                                    +\n                                </span>\n                            </div>\n                            <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-3-1-1-2-2-2\">\n                                مهندس مكرّم\n                            </p>\n                        </div>\n                        <div class=\"pe-2\" data-kid=\"1-2-3-1-1-2-3\">\n                            <div class=\"ui text-[30px] font-bold text-[var(--navy)]\" data-kid=\"1-2-3-1-1-2-3-1\">\n                                12\n                                <span class=\"text-[var(--gold)]\" data-kid=\"1-2-3-1-1-2-3-1-1\">\n                                    +\n                                </span>\n                            </div>\n                            <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-3-1-1-2-3-2\">\n                                جهة راعية\n                            </p>\n                        </div>\n                    </div>\n                    <section class=\"scroll-mt-24 mt-14\" data-kid=\"1-2-3-1-1-3\" id=\"highlights\">\n                        <p class=\"ui text-[11px] font-bold tracking-[.15em] text-[var(--gold)]\" data-kid=\"1-2-3-1-1-3-1\">\n                            02 / أبرز ما يميزها\n                        </p>\n                        <h3 class=\"display mt-3 text-[27px] font-bold text-[var(--navy)]\" data-kid=\"1-2-3-1-1-3-2\">\n                            برنامج يضع الإنجاز في الواجهة\n                        </h3>\n                        <div class=\"mt-7 grid gap-3 sm:grid-cols-2\" data-kid=\"1-2-3-1-1-3-3\">\n                            <div class=\"flex gap-3 border border-[var(--hairline)] bg-white p-4\" data-kid=\"1-2-3-1-1-3-3-1\">\n                                <span class=\"mt-1 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[var(--gold-soft)]\" data-kid=\"1-2-3-1-1-3-3-1-1\">\n                                    <i class=\"ti ti-check\" data-kid=\"1-2-3-1-1-3-3-1-1-1\" style=\"color:#1b1938;width:14px;height:14px;font-size:14px\">\n                                    </i>\n                                </span>\n                                <p class=\"text-[13px] leading-[1.8] text-[var(--muted)]\" data-