      "viewportScrollY": 0
    },
    "var_0cc64b4ebc6a": {
      "type": "variant",
      "label": "الفعاليات — برنامج رئيسي",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 8280,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --indigo: #1b1938;\n    --indigo-deep: #0e0c1f;\n    --navy: #102a66;\n    --navy-deep: #071b45;\n    --gold: #d3a53e;\n    --gold-soft: #f0d48a;\n    --teal: #0e3030;\n    --teal-mid: #155555;\n    --ink: #292827;\n    --ink-mute: #6d6965;\n    --canvas: #ffffff;\n    --canvas-soft: #fafaf8;\n    --hairline: #e8e4dd;\n  }\n\n  .bse-page {\n    font-family: 'IBM Plex Sans Arabic', 'Inter', sans-serif;\n    color: var(--ink);\n    background: var(--canvas);\n    line-height: 1.6;\n  }\n\n  .bse-page h1,\n  .bse-page h2,\n  .bse-page h3,\n  .bse-page h4,\n  .bse-page .display-font {\n    font-family: 'Cairo', 'IBM Plex Sans Arabic', sans-serif;\n  }\n\n  .bse-page .display-font {\n    font-variation-settings: 'wght' 700;\n    letter-spacing: -0.035em;\n  }\n\n  .bse-hero {\n    min-height: 410px;\n    isolation: isolate;\n  }\n\n  .bse-hero::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: -1;\n    background:\n      linear-gradient(90deg, rgba(7, 27, 69, 0.93) 0%, rgba(16, 42, 102, 0.79) 46%, rgba(7, 27, 69, 0.48) 100%),\n      linear-gradient(180deg, rgba(7, 27, 69, 0.15), rgba(7, 27, 69, 0.78));\n  }\n\n  .bse-hero-grid {\n    background-image:\n      linear-gradient(rgba(240, 212, 138, 0.13) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(240, 212, 138, 0.13) 1px, transparent 1px);\n    background-size: 36px 36px;\n    mask-image: linear-gradient(90deg, transparent 0%, black 48%, black 100%);\n  }\n\n  .feature-row {\n    border: 1px solid var(--hairline);\n    border-inline-start: 4px solid var(--gold);\n    background: var(--canvas);\n  }\n\n  .feature-row.secondary {\n    border-inline-start-color: var(--navy);\n    background: var(--canvas-soft);\n  }\n\n  .feature-row.tertiary {\n    border-inline-start-color: var(--teal-mid);\n    background: #f4f6f5;\n  }\n\n  .feature-image {\n    min-height: 190px;\n  }\n\n  .timeline-list {\n    position: relative;\n  }\n\n  .timeline-list::before {\n    content: '';\n    position: absolute;\n    top: 10px;\n    bottom: 10px;\n    inset-inline-end: 142px;\n    width: 2px;\n    background: linear-gradient(var(--gold-soft), var(--gold), var(--gold-soft));\n  }\n\n  .event-row {\n    position: relative;\n    z-index: 1;\n    border-block-end: 1px solid var(--hairline);\n    background: var(--canvas);\n  }\n\n  .event-row::before {\n    content: '';\n    position: absolute;\n    inset-inline-end: 136px;\n    top: 30px;\n    width: 14px;\n    height: 14px;\n    border: 3px solid var(--canvas-soft);\n    border-radius: 9999px;\n    background: var(--gold);\n    box-shadow: 0 0 0 1px var(--gold);\n  }\n\n  .event-row:hover {\n    background: #fffdf7;\n  }\n\n  .event-row.is-hidden {\n    display: none;\n  }\n\n  .icon-box {\n    display: inline-grid;\n    place-items: center;\n    width: 42px;\n    height: 42px;\n    border-radius: 8px;\n    background: #eef1f8;\n    color: var(--navy);\n  }\n\n  .number-rule {\n    height: 2px;\n    width: 42px;\n    background: var(--gold);\n  }\n\n  .bse-page button,\n  .bse-page a {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  @media (max-width: 767px) {\n    .bse-hero {\n      min-height: 500px;\n    }\n\n    .timeline-list::before,\n    .event-row::before {\n      display: none;\n    }\n\n    .event-row {\n      display: block;\n    }\n  }\n</style>\n<div class=\"bse-page min-h-screen\" data-kid=\"1\" dir=\"rtl\">\n    <header class=\"border-b border-[#e8e4dd] bg-white\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex min-h-[82px] max-w-[1180px] items-center gap-6 px-6 lg:px-8\" data-kid=\"1-1-1\">\n            <a aria-label=\"BSE Event — الصفحة الرئيسية\" class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"size-12 rounded-full border border-[#d3a53e]/50 bg-white object-contain p-0.5\" data-kid=\"1-1-1-1-1\" decoding=\"async\" height=\"48\" loading=\"lazy\" src=\"/api/local/images/public/favicon.png\" width=\"48\"/>\n                <span class=\"leading-tight\" data-kid=\"1-1-1-1-2\">\n                    <span class=\"display-font block text-[20px] font-bold text-[#102a66]\" data-kid=\"1-1-1-1-2-1\">\n                        BSE Event\n                    </span>\n                    <span class=\"block text-[11px] font-medium text-[#6d6965]\" data-kid=\"1-1-1-1-2-2\">\n                        قسم الفعاليات والمؤتمرات والمعارض\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"hidden flex-1 items-center justify-center gap-1 lg:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"rounded-md px-3 py-2 text-[14px] font-semibold text-[#292827] hover:bg-[#f4f6fb] hover:text-[#102a66]\" data-kid=\"1-1-1-2-1\" href=\"#top\">\n                    الرئيسية\n                </a>\n                <a class=\"rounded-md px-3 py-2 text-[14px] font-semibold text-[#292827] hover:bg-[#f4f6fb] hover:text-[#102a66]\" data-kid=\"1-1-1-2-2\" href=\"#about\">\n                    من نحن\n                </a>\n                <a class=\"rounded-md px-3 py-2 text-[14px] font-semibold text-[#292827] hover:bg-[#f4f6fb] hover:text-[#102a66]\" data-kid=\"1-1-1-2-3\" href=\"#conferences\">\n                    المؤتمرات\n                </a>\n                <a class=\"rounded-md px-3 py-2 text-[14px] font-semibold text-[#292827] hover:bg-[#f4f6fb] hover:text-[#102a66]\" data-kid=\"1-1-1-2-4\" href=\"#exhibitions\">\n                    المعارض\n                </a>\n                <a class=\"rounded-md bg-[#eef1f8] px-3 py-2 text-[14px] font-bold text-[#102a66]\" data-kid=\"1-1-1-2-5\" href=\"#events\">\n                    الفعاليات\n                </a>\n                <a class=\"rounded-md px-3 py-2 text-[14px] font-semibold text-[#292827] hover:bg-[#f4f6fb] hover:text-[#102a66]\" data-kid=\"1-1-1-2-6\" href=\"#sponsors\">\n                    الرعاة\n                </a>\n            </nav>\n            <div class=\"ms-auto flex items-center gap-3\" data-kid=\"1-1-1-3\">\n                <button aria-label=\"تغيير اللغة\" class=\"hidden items-center gap-1.5 rounded-md px-2 py-2 text-[13px] font-semibold text-[#102a66] sm:inline-flex\" data-kid=\"1-1-1-3-1\" type=\"button\">\n                    <i class=\"ti ti-language text-[17px]\" data-kid=\"1-1-1-3-1-1\" style=\"width:17px;height:17px;color:#102a66;\">\n                    </i>\n                    English\n                </button>\n                <a class=\"hidden rounded-md bg-[#102a66] px-4 py-3 text-[13px] font-bold text-white shadow-[0_4px_12px_rgba(16,42,102,0.18)] sm:inline-flex\" data-kid=\"1-1-1-3-2\" href=\"#contact\">\n                    كن راعيًا\n                </a>\n                <button aria-label=\"فتح القائمة\" class=\"grid size-11 place-items-center rounded-md border border-[#e8e4dd] text-[#102a66] lg:hidden\" data-kid=\"1-1-1-3-3\" type=\"button\">\n                    <i class=\"ti ti-menu-2 text-[20px]\" data-kid=\"1-1-1-3-3-1\" style=\"width:20px;height:20px;color:#102a66;\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"bse-hero relative overflow-hidden bg-[#071b45] text-white\" data-kid=\"1-2-1\">\n            <img alt=\"حفل هندسي وتكريم مهندسين — صورة من مكتبة BSE Event\" class=\"absolute inset-0 -z-20 size-full object-cover object-center\" data-kid=\"1-2-1-1\" decoding=\"async\" height=\"1088\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-events.jpg\" width=\"1920\"/>\n            <div aria-hidden=\"true\" class=\"bse-hero-grid absolute inset-0 -z-10 opacity-70\" data-kid=\"1-2-1-2\">\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute inset-y-0 start-0 -z-10 w-1/3 bg-[#071b45]/50\" data-kid=\"1-2-1-3\">\n            </div>\n            <div class=\"relative mx-auto flex min-h-[410px] max-w-[1180px] items-center px-6 py-16 lg:px-8\" data-kid=\"1-2-1-4\">\n                <div class=\"max-w-[720px]\" data-kid=\"1-2-1-4-1\">\n                    <div class=\"mb-5 flex flex-wrap items-center gap-3\" data-kid=\"1-2-1-4-1-1\">\n                        <span class=\"inline-flex items-center gap-2 rounded-full border border-[#f0d48a]/50 bg-[#071b45]/45 px-3 py-1.5 text-[12px] font-bold text-[#f0d48a]\" data-kid=\"1-2-1-4-1-1-1\">\n                            <i class=\"ti ti-calendar-event text-[15px]\" data-kid=\"1-2-1-4-1-1-1-1\" style=\"width:15px;height:15px;color:#f0d48a;\">\n                            </i>\n                            120+ فعالية سنويًا\n                        </span>\n                        <span class=\"text-[12px] font-medium text-white/70\" data-kid=\"1-2-1-4-1-1-2\">\n                            BSE Event Programme / 2026\n                        </span>\n                    </div>\n                    <p class=\"mb-3 text-[13px] font-bold tracking-[0.18em] text-[#f0d48a]\" data-kid=\"1-2-1-4-1-2\">\n                        الفعاليات والأنشطة والندوات\n                    </p>\n                    <h1 class=\"display-font max-w-[680px] text-[42px] font-bold leading-[1.13] text-white sm:text-[54px]\" data-kid=\"1-2-1-4-1-3\">\n                        فعاليات تصنع حضورًا للمهندس\n                    </h1>\n                    <p class=\"mt-5 max-w-[650px] text-[17px] leading-[1.9] text-white/82\" data-kid=\"1-2-1-4-1-4\">\n                        برنامج سنوي من الفعاليات الوطنية والاجتماعية والندوات الفنية والزيارات الميدانية، يربط أعضاء الجمعية بالمهنة وسوق العمل وبصنّاع القرار.\n                    </p>\n                    <a class=\"mt-8 inline-flex items-center gap-2 rounded-md bg-[#d3a53e] px-5 py-3.5 text-[14px] font-bold text-[#071b45] shadow-[0_8px_20px_rgba(0,0,0,0.16)] hover:bg-[#f0d48a]\" data-kid=\"1-2-1-4-1-5\" href=\"#programme\">\n                        اكتشف البرنامج\n                        <i class=\"ti ti-arrow-left text-[17px]\" data-kid=\"1-2-1-4-1-5-1\" style=\"width:17px;height:17px;color:#071b45;\">\n                        </i>\n                    </a>\n                </div>\n                <div aria-hidden=\"true\" class=\"pointer-events-none absolute bottom-[-20px] start-[-6px] hidden select-none font-['Cairo'] text-[170px] font-extrabold leading-none text-white/8 xl:block\" data-kid=\"1-2-1-4-2\">\n                    120+\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"إحصاءات الفعاليات\" class=\"border-b border-[#263d72] bg-[#0e0c1f] text-white\" data-kid=\"1-2-2\">\n            <div class=\"mx-auto grid max-w-[1180px] grid-cols-2 divide-x divide-x-reverse divide-[#3f3a52] px-6 py-7 lg:grid-cols-4 lg:px-8\" data-kid=\"1-2-2-1\">\n                <div class=\"px-5 py-2 first:pe-0 lg:px-7\" data-kid=\"1-2-2-1-1\">\n                    <p class=\"display-font text-[34px] font-bold leading-none text-[#f0d48a]\" data-kid=\"1-2-2-1-1-1\">\n                        120+\n                    </p>\n                    <p class=\"mt-2 text-[12px] text-white/65\" data-kid=\"1-2-2-1-1-2\">\n                        فعالية ونشاط سنويًا\n                    </p>\n                </div>\n                <div class=\"px-5 py-2 lg:px-7\" data-kid=\"1-2-2-1-2\">\n                    <p class=\"display-font text-[34px] font-bold leading-none text-[#f0d48a]\" data-kid=\"1-2-2-1-2-1\">\n                        9000+\n                    </p>\n                    <p class=\"mt-2 text-[12px] text-white/65\" data-kid=\"1-2-2-1-2-2\">\n                        مشارك وحاضر\n                    </p>\n                </div>\n                <div class=\"px-5 py-2 lg:px-7\" data-kid=\"1-2-2-1-3\">\n                    <p class=\"display-font text-[34px] font-bold leading-none text-[#f0d48a]\" data-kid=\"1-2-2-1-3-1\">\n                        150+\n                    </p>\n                    <p class=\"mt-2 text-[12px] text-white/65\" data-kid=\"1-2-2-1-3-2\">\n                        متطوع في التنفيذ\n                    </p>\n                </div>\n                <div class=\"px-5 py-2 last:ps-0 lg:px-7\" data-kid=\"1-2-2-1-4\">\n                    <p class=\"display-font text-[34px] font-bold leading-none text-[#f0d48a]\" data-kid=\"1-2-2-1-4-1\">\n                        30+\n                    </p>\n                    <p class=\"mt-2 text-[12px] text-white/65\" data-kid=\"1-2-2-1-4-2\">\n                        جهة شريكة\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-white px-6 py-16 lg:px-8 lg:py-20\" data-kid=\"1-2-3\" id=\"events\">\n            <div class=\"mx-auto max-w-[1180px]\" data-kid=\"1-2-3-1\">\n                <div class=\"flex flex-col justify-between gap-6 border-b border-[#e8e4dd] pb-8 sm:flex-row sm:items-end\" data-kid=\"1-2-3-1-1\">\n                    <div data-kid=\"1-2-3-1-1-1\">\n                        <p class=\"text-[12px] font-bold tracking-[0.16em] text-[#d3a53e]\" data-kid=\"1-2-3-1-1-1-1\">\n                            فعاليات رئيسية\n                        </p>\n                        <h2 class=\"display-font mt-2 text-[32px] font-bold leading-tight text-[#102a66] sm:text-[40px]\" data-kid=\"1-2-3-1-1-1-2\">\n                            ثلاث محطات تجمع المجتمع الهندسي\n                        </h2>\n                        <div class=\"number-rule mt-5\" data-kid=\"1-2-3-1-1-1-3\">\n                        </div>\n                    </div>\n                    <p class=\"max-w-[390px] text-[14px] leading-[1.9] text-[#6d6965]\" data-kid=\"1-2-3-1-1-2\">\n                        صفحات خاصة لكل فع