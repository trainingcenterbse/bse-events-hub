      "themeId": null,
      "rect": {
        "x": 6900,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --indigo: #1b1938;\n    --indigo-deep: #0e0c1f;\n    --navy: #10275d;\n    --navy-deep: #0b1b47;\n    --teal: #0e3030;\n    --teal-mid: #155555;\n    --gold: #d9a83a;\n    --gold-soft: #f0d58b;\n    --violet: #c9b4fa;\n    --ink: #292827;\n    --ink-mute: #73706d;\n    --ink-faint: #9a9794;\n    --canvas: #ffffff;\n    --canvas-soft: #fafaf8;\n    --hairline: #e8e4dd;\n    --hairline-dark: #3f3a52;\n    --on-dark-mute: #bcbac9;\n    --font-body: 'IBM Plex Sans Arabic', 'Inter', sans-serif;\n    --font-display: 'Cairo', 'IBM Plex Sans Arabic', sans-serif;\n  }\n\n  .font-body { font-family: var(--font-body); }\n  .font-display { font-family: var(--font-display); }\n  .arabic-heading { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; line-height: 1.12; }\n  .display-number { font-family: 'Inter', var(--font-display); font-variant-numeric: tabular-nums; letter-spacing: -0.06em; line-height: .9; }\n  .icon { display: inline-grid; width: 20px; height: 20px; place-items: center; line-height: 1; }\n  .icon-sm { display: inline-grid; width: 16px; height: 16px; place-items: center; line-height: 1; }\n  .hero-wash { background: linear-gradient(90deg, rgba(14,12,31,.98) 0%, rgba(16,39,93,.86) 48%, rgba(16,39,93,.36) 100%); }\n  .hero-panel { background: linear-gradient(135deg, rgba(14,12,31,.96), rgba(16,39,93,.82)); }\n  .gold-line { background: linear-gradient(90deg, var(--gold), var(--gold-soft)); }\n  .paper-grid { background-image: linear-gradient(rgba(16,39,93,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(16,39,93,.08) 1px, transparent 1px); background-size: 22px 22px; }\n  .dark-grid { background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px); background-size: 28px 28px; }\n  .map-grid { background-color: #eef1f5; background-image: linear-gradient(28deg, transparent 47%, rgba(16,39,93,.12) 48%, rgba(16,39,93,.12) 50%, transparent 51%), linear-gradient(118deg, transparent 48%, rgba(16,39,93,.10) 49%, rgba(16,39,93,.10) 51%, transparent 52%), linear-gradient(rgba(16,39,93,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(16,39,93,.08) 1px, transparent 1px); background-size: 130px 92px, 170px 110px, 22px 22px, 22px 22px; }\n  .soft-shadow { box-shadow: 0 1px 3px rgba(14,12,31,.08), 0 16px 48px rgba(14,12,31,.10); }\n  .hairline-shadow { box-shadow: 0 1px 0 rgba(14,12,31,.08); }\n  .tab-active { background: var(--gold); color: var(--indigo-deep); border-color: var(--gold); }\n  .tab-idle { color: rgba(255,255,255,.72); border-color: rgba(255,255,255,.24); }\n  .table-row-a { background: var(--navy); }\n  .table-row-b { background: var(--teal-mid); }\n  .table-row-a:hover, .table-row-b:hover { background: #236d6d; }\n  .anchor-active { color: var(--indigo); border-bottom-color: var(--gold); }\n  .anchor-idle { color: var(--ink-mute); border-bottom-color: transparent; }\n  .schedule-panel[hidden] { display: none; }\n  .no-wrap { white-space: nowrap; }\n  @media (max-width: 767px) {\n    .hero-wash { background: linear-gradient(180deg, rgba(14,12,31,.68), rgba(14,12,31,.98) 72%); }\n  }\n</style>\n<div class=\"font-body min-h-screen bg-[var(--canvas)] text-[var(--ink)]\" data-kid=\"1\" dir=\"rtl\">\n    <header class=\"sticky top-0 z-50 border-b border-[var(--hairline)] bg-[rgba(255,255,255,.96)] backdrop-blur-md\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-[78px] max-w-[1180px] items-center gap-7 px-6\" data-kid=\"1-1-1\">\n            <a aria-label=\"BSE Event\" class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span class=\"grid size-11 place-items-center rounded-full border border-[var(--gold)] bg-white p-1 shadow-sm\" data-kid=\"1-1-1-1-1\">\n                    <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"size-full rounded-full object-contain\" data-kid=\"1-1-1-1-1-1\" decoding=\"async\" height=\"44\" loading=\"lazy\" src=\"/api/local/images/public/favicon.png\" width=\"44\"/>\n                </span>\n                <span class=\"leading-tight\" data-kid=\"1-1-1-1-2\">\n                    <span class=\"font-display block text-[19px] font-extrabold tracking-[-.04em] text-[var(--navy)]\" data-kid=\"1-1-1-1-2-1\">\n                        BSE Event\n                    </span>\n                    <span class=\"block text-[11px] font-medium text-[var(--ink-mute)]\" data-kid=\"1-1-1-1-2-2\">\n                        قسم الفعاليات والمؤتمرات والمعارض\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"hidden flex-1 items-center justify-center gap-1 lg:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"rounded-md px-3 py-2 text-[13px] font-semibold text-[var(--ink-mute)] hover:bg-[var(--canvas-soft)] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-1\" href=\"#top\">\n                    الرئيسية\n                </a>\n                <a class=\"rounded-md px-3 py-2 text-[13px] font-semibold text-[var(--ink-mute)] hover:bg-[var(--canvas-soft)] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-2\" href=\"#overview\">\n                    المؤتمرات\n                </a>\n                <a class=\"rounded-md px-3 py-2 text-[13px] font-semibold text-[var(--ink-mute)] hover:bg-[var(--canvas-soft)] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-3\" href=\"#program\">\n                    البرنامج\n                </a>\n                <a class=\"rounded-md px-3 py-2 text-[13px] font-semibold text-[var(--ink-mute)] hover:bg-[var(--canvas-soft)] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-4\" href=\"#speakers\">\n                    المتحدثون\n                </a>\n                <a class=\"rounded-md px-3 py-2 text-[13px] font-semibold text-[var(--ink-mute)] hover:bg-[var(--canvas-soft)] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-5\" href=\"#location\">\n                    الموقع\n                </a>\n            </nav>\n            <div class=\"ms-auto flex items-center gap-3\" data-kid=\"1-1-1-3\">\n                <button class=\"hidden items-center gap-1.5 text-[12px] font-semibold text-[var(--navy)] sm:inline-flex\" data-kid=\"1-1-1-3-1\" type=\"button\">\n                    <span aria-hidden=\"true\" class=\"icon-sm ti ti-world\" data-kid=\"1-1-1-3-1-1\">\n                    </span>\n                    English\n                </button>\n                <a class=\"inline-flex min-h-10 items-center justify-center rounded-lg bg-[var(--navy)] px-4 text-[12px] font-bold text-white shadow-sm hover:bg-[var(--indigo)]\" data-kid=\"1-1-1-3-2\" href=\"#contact\">\n                    كن راعياً\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"relative min-h-[470px] overflow-hidden bg-[var(--indigo-deep)]\" data-kid=\"1-2-1\">\n            <img alt=\"غلاف مؤتمر ومعرض إدارة الطاقة — الملتقى الهندسي الخليجي 26\" class=\"absolute inset-0 size-full object-cover\" data-kid=\"1-2-1-1\" decoding=\"async\" height=\"1080\" loading=\"lazy\" src=\"/api/local/images/src/assets/conf-energy.jpg\" width=\"1920\"/>\n            <div class=\"hero-wash absolute inset-0\" data-kid=\"1-2-1-2\">\n            </div>\n            <div class=\"dark-grid absolute inset-0 opacity-40\" data-kid=\"1-2-1-3\">\n            </div>\n            <div class=\"relative mx-auto flex min-h-[470px] max-w-[1180px] items-center px-6 py-16\" data-kid=\"1-2-1-4\">\n                <div class=\"grid w-full items-center gap-12 lg:grid-cols-[minmax(280px,.7fr)_minmax(0,1.6fr)]\" data-kid=\"1-2-1-4-1\">\n                    <div class=\"hero-panel order-2 hidden min-h-[250px] flex-col justify-between border border-white/15 p-7 text-white lg:order-1 lg:flex\" data-kid=\"1-2-1-4-1-1\">\n                        <div class=\"flex items-center justify-between border-b border-white/15 pb-5\" data-kid=\"1-2-1-4-1-1-1\">\n                            <span class=\"font-display text-[12px] font-bold tracking-[.16em] text-[var(--gold-soft)]\" data-kid=\"1-2-1-4-1-1-1-1\">\n                                BSE / ENERGY 26\n                            </span>\n                            <span aria-hidden=\"true\" class=\"icon text-[var(--gold-soft)] ti ti-scan\" data-kid=\"1-2-1-4-1-1-1-2\">\n                            </span>\n                        </div>\n                        <div class=\"mt-8\" data-kid=\"1-2-1-4-1-1-2\">\n                            <p class=\"text-[11px] font-semibold uppercase tracking-[.18em] text-white/55\" data-kid=\"1-2-1-4-1-1-2-1\">\n                                GULF ENGINEERING FORUM\n                            </p>\n                            <p class=\"mt-2 max-w-[210px] font-display text-[19px] font-bold leading-snug text-white\" data-kid=\"1-2-1-4-1-1-2-2\">\n                                منصة خليجية للقرارات الهندسية المؤثرة\n                            </p>\n                        </div>\n                        <div class=\"mt-10 flex items-end justify-between\" data-kid=\"1-2-1-4-1-1-3\">\n                            <span class=\"display-number text-6xl font-semibold text-[var(--gold)]\" data-kid=\"1-2-1-4-1-1-3-1\">\n                                26\n                            </span>\n                            <span class=\"max-w-[110px] text-left text-[11px] leading-relaxed text-white/60\" data-kid=\"1-2-1-4-1-1-3-2\">\n                                النسخة الحالية\n                                <br data-kid=\"1-2-1-4-1-1-3-2-1\"/>\n                                استضافة جمعية المهندسين البحرينية\n                            </span>\n               