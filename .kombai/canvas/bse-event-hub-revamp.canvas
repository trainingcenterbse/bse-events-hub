ages/src/assets/team-work.jpg\" width=\"1600\"/>\n                    <div class=\"absolute inset-0 bg-[var(--navy)]/55\" data-kid=\"1-2-5-1-1-2\">\n                    </div>\n                    <div class=\"absolute inset-0 blueprint opacity-30\" data-kid=\"1-2-5-1-1-3\">\n                    </div>\n                    <div class=\"absolute bottom-5 start-5 border border-white/25 bg-[var(--navy)]/80 px-4 py-3\" data-kid=\"1-2-5-1-1-4\">\n                        <p class=\"ui text-[10px] tracking-[.12em] text-[var(--gold)]\" data-kid=\"1-2-5-1-1-4-1\">\n                            BSE EVENT STANDARD\n                        </p>\n                        <p class=\"mt-1 text-[12px] font-semibold text-white\" data-kid=\"1-2-5-1-1-4-2\">\n                            مهنة · إنجاز · أثر\n                        </p>\n                    </div>\n                </div>\n                <div data-kid=\"1-2-5-1-2\">\n                    <p class=\"ui text-[11px] font-bold tracking-[.15em] text-[var(--gold)]\" data-kid=\"1-2-5-1-2-1\">\n                        04 / لماذا هذه الفعالية؟\n                    </p>\n                    <h2 class=\"display mt-3 text-[32px] font-extrabold leading-tight text-[var(--navy)] sm:text-[40px]\" data-kid=\"1-2-5-1-2-2\">\n                        احتفاء رسمي يربط الإنجاز بالمستقبل\n                    </h2>\n                    <p class=\"mt-5 text-[15px] leading-[2] text-[var(--muted)]\" data-kid=\"1-2-5-1-2-3\">\n                        صُممت الفعالية لتكون أكثر من حفل؛ إنها مساحة تلتقي فيها الخبرة الوطنية مع الجيل القادم، وتتحول فيها قصص الإنجاز إلى فرص تعاون جديدة.\n                    </p>\n                    <div class=\"mt-7 grid gap-4 sm:grid-cols-3\" data-kid=\"1-2-5-1-2-4\">\n                        <div class=\"border-t-2 border-[var(--gold)] pt-3\" data-kid=\"1-2-5-1-2-4-1\">\n                            <p class=\"text-[14px] font-bold text-[var(--navy)]\" data-kid=\"1-2-5-1-2-4-1-1\">\n                                اعتراف\n                            </p>\n                            <p class=\"mt-2 text-[12px] leading-[1.7] text-[var(--muted)]\" data-kid=\"1-2-5-1-2-4-1-2\">\n                                نحتفي بالخبرات والمسيرات التي صنعت فرقاً.\n                            </p>\n                        </div>\n                        <div class=\"border-t-2 border-[var(--gold)] pt-3\" data-kid=\"1-2-5-1-2-4-2\">\n                            <p class=\"text-[14px] font-bold text-[var(--navy)]\" data-kid=\"1-2-5-1-2-4-2-1\">\n                                معرفة\n                            </p>\n                            <p class=\"mt-2 text-[12px] leading-[1.7] text-[var(--muted)]\" data-kid=\"1-2-5-1-2-4-2-2\">\n                                نشارك المشاريع والحلول الهندسية أمام المجتمع.\n                            </p>\n                        </div>\n                        <div class=\"border-t-2 border-[var(--gold)] pt-3\" data-kid=\"1-2-5-1-2-4-3\">\n                            <p class=\"text-[14px] font-bold text-[var(--navy)]\" data-kid=\"1-2-5-1-2-4-3-1\">\n                                شبكة\n                            </p>\n                            <p class=\"mt-2 text-[12px] leading-[1.7] text-[var(--muted)]\" data-kid=\"1-2-5-1-2-4-3-2\">\n                                نفتح حواراً عملياً بين المهندس والشريك.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[var(--canvas-soft)] px-6 py-16 lg:px-0\" data-kid=\"1-2-6\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-6-1\">\n                <div class=\"flex flex-col gap-3 border-b border-[var(--hairline)] pb-6 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-2-6-1-1\">\n                    <div data-kid=\"1-2-6-1-1-1\">\n                        <p class=\"ui text-[11px] font-bold tracking-[.15em] text-[var(--gold)]\" data-kid=\"1-2-6-1-1-1-1\">\n                            05 / فعاليات ذات صلة\n                        </p>\n                        <h2 class=\"display mt-3 text-[30px] font-extrabold text-[var(--navy)]\" data-kid=\"1-2-6-1-1-1-2\">\n                            تابع برنامج الجمعية\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[380px] text-[12px] leading-[1.8] text-[var(--muted)]\" data-kid=\"1-2-6-1-1-2\">\n                        اكتشف فعالياتنا المؤسسية والاجتماعية الأخرى، بنفس مستوى التنظيم والوضوح.\n                    </p>\n                </div>\n                <div class=\"mt-8 grid gap-4 md:grid-cols-2\" data-kid=\"1-2-6-1-2\">\n                    <a class=\"group flex items-center justify-between border border-[var(--hairline)] bg-white p-5 no-underline hover:border-[var(--gold)]\" data-kid=\"1-2-6-1-2-1\" href=\"#\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-6-1-2-1-1\">\n                            <span class=\"grid h-12 w-12 place-items-center bg-[var(--navy)] text-[var(--gold)]\" data-kid=\"1-2-6-1-2-1-1-1\">\n                                <i class=\"ti ti-building-community\" data-kid=\"1-2-6-1-2-1-1-1-1\" style=\"color:#c9a65a;width:22px;height:22px;font-size:22px\">\n                                </i>\n                            </span>\n                            <div data-kid=\"1-2-6-1-2-1-1-2\">\n                                <p class=\"text-[11px] font-bold text-[var(--gold)]\" data-kid=\"1-2-6-1-2-1-1-2-1\">\n                                    اجتماع مؤسسي\n                                </p>\n                                <h3 class=\"display mt-1 text-[18px] font-bold text-[var(--navy)]\" data-kid=\"1-2-6-1-2-1-1-2-2\">\n                                    الجمعية العمومية السنوية\n                                </h3>\n                            </div>\n                        </div>\n                        <i class=\"ti ti-arrow-up-left\" data-kid=\"1-2-6-1-2-1-2\" style=\"color:#1b1938;width:20px;height:20px;font-size:20px\">\n                        </i>\n                    </a>\n                    <a class=\"group flex items-center justify-between border border-[var(--hairline)] bg-white p-5 no-underline hover:border-[var(--gold)]\" data-kid=\"1-2-6-1-2-2\" href=\"#\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-6-1-2-2-1\">\n                            <span class=\"grid h-12 w-12 place-items-center bg-[var(--navy)] text-[var(--gold)]\" data-kid=\"1-2-6-1-2-2-1-1\">\n                                <i class=\"ti ti-moon-stars\" data-kid=\"1-2-6-1-2-2-1-1-1\" style=\"color:#c9a65a;width:22px;height:22px;font-size:22px\">\n                                </i>\n                            </span>\n                            <div data-kid=\"1-2-6-1-2-2-1-2\">\n                                <p class=\"text-[11px] font-bold text-[var(--gold)]\" data-kid=\"1-2-6-1-2-2-1-2-1\">\n                                    لقاء اجتماعي\n                                </p>\n                                <h3 class=\"display mt-1 text-[18px] font-bold text-[var(--navy)]\" data-kid=\"1-2-6-1-2-2-1-2-2\">\n                                    الغبقة الرمضانية السنوية\n                                </h3>\n                            </div>\n                        </div>\n                        <i class=\"ti ti-arrow-up-left\" data-kid=\"1-2-6-1-2-2-2\" style=\"color:#1b1938;width:20px;height:20px;font-size:20px\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[var(--teal)] px-6 py-20 text-white lg:px-0 lg:py-24\" data-kid=\"1-2-7\">\n            <div class=\"mx-auto flex max-w-[900px] flex-col items-center text-center\" data-kid=\"1-2-7-1\">\n                <p class=\"ui text-[11px] font-bold tracking-[.18em] text-[var(--gold)]\" data-kid=\"1-2-7-1-1\">\n                    BSE EVENTS TEAM\n                </p>\n                <h2 class=\"display mt-4 text-[32px] font-extrabold sm:text-[42px]\" data-kid=\"1-2-7-1-2\">\n                    نظّم حضور فريقك بثقة\n                </h2>\n                <p class=\"mt-4 max-w-[560px] text-[15px] leading-[1.9] text-white/65\" data-kid=\"1-2-7-1-3\">\n                    تواصل مع فريق التنظيم للحصول على تفاصيل التسجيل، الرعاية، أو المشاركة في معرض المشاريع الوطنية.\n                </p>\n                <a class=\"ui mt-8 inline-flex h-12 items-center justify-center gap-2 rounded-[8px] bg-white px-6 text-[13px] font-bold text-[var(--teal)] no-underline\" data-kid=\"1-2-7-1-4\" href=\"#footer-contact\">\n                    تواصل مع فريق التنظيم\n                    <i class=\"ti ti-arrow-left\" data-kid=\"1-2-7-1-4-1\" style=\"color:#0e3030;width:17px;height:17px;font-size:17px\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[var(--navy-deep)] px-6 py-12 text-white lg:px-0\" data-kid=\"1-3\" id=\"footer-contact\">\n        <div class=\"mx-auto grid max-w-[1120px] gap-10 md:grid-cols-[1.4fr_.8fr_.9fr]\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1\">\n                    <span class=\"grid h-11 w-11 place-items-center rounded-full bg-white p-1\" data-kid=\"1-3-1-1-1-1\">\n                        <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"h-full w-full rounded-full object-cover\" data-kid=\"1-3-1-1-1-1-1\" decoding=\"async\" height=\"44\" loading=\"lazy\" src=\"/api/local/images/public/favicon.png\" width=\"44\"/>\n                    </span>\n                    <div data-kid=\"1-3-1-1-1-2\">\n                        <p class=\"display text-[18px] font-bold\" data-kid=\"1-3-1-1-1-2-1\">\n                            BSE Event\n                        </p>\n                        <p class=\"text-[11px] text-white/55\" data-kid=\"1-3-1-1-1-2-2\">\n                            جمعية المهندسين البحرينية\n                        </p>\n                    </div>\n                </div>\n                <p class=\"mt-5 max-w-[430px] text-[12px] leading-[1.9] text-white/55\" data-kid=\"1-3-1-1-2\">\n                    قسم إدارة الفعاليات والمؤتمرات والمعارض — منصات هندسية متخصصة تجمع الرعاة والعارضين والحضور في مكان واحد.\n                </p>\n            </div>\n            <div data-kid=\"1-3-1-2\">\n                <h3 class=\"text-[12px] font-bold text-[var(--gold)]\" data-kid=\"1-3-1-2-1\">\n                    روابط سريعة\n                </h3>\n                <div class=\"mt-4 grid gap-2 text-[12px] text-white/60\" data-kid=\"1-3-1-2-2\">\n                    <a class=\"no-underline hover:text-white\" data-kid=\"1-3-1-2-2-1\" href=\"#about\">\n                        عن الفعالية\n                    </a>\n                    <a class=\"no-underline hover:text-white\" data-kid=\"1-3-1-2-2-2\" href=\"#schedule\">\n                        البرنامج\n                    </a>\n                    <a class=\"no-underline hover:text-white\" data-kid=\"1-3-1-2-2-3\" href=\"#location\">\n                        الموقع\n                    </a>\n                </div>\n            </div>\n            <div data-kid=\"1-3-1-3\">\n                <h3 class=\"text-[12px] font-bold text-[var(--gold)]\" data-kid=\"1-3-1-3-1\">\n                    تواصل معنا\n                </h3>\n                <div class=\"mt-4 grid gap-3 text-[12px] text-white/60\" data-kid=\"1-3-1-3-2\">\n                    <span class=\"inline-flex items-center gap-2\" data-kid=\"1-3-1-3-2-1\">\n                        <i class=\"ti ti-map-pin\" data-kid=\"1-3-1-3-2-1-1\" style=\"color:#c9a65a;width:16px;height:16px;font-size:16px\">\n                        </i>\n                        مبنى الجمعية، الجفير\n                    </span>\n                    <span class=\"inline-flex items-center gap-2\" data-kid=\"1-3-1-3-2-2\">\n                        <i class=\"ti ti-phone\" data-kid=\"1-3-1-3-2-2-1\" style=\"color:#c9a65a;width:16px;height:16px;font-size:16px\">\n                        </i>\n                        <span data-kid=\"1-3-1-3-2-2-2\" dir=\"ltr\">\n                            +973 1772 7100\n                        </span>\n                    </span>\n                    <span class=\"inline-flex items-center gap-2\" data-kid=\"1-3-1-3-2-3\">\n                        <i class=\"ti ti-mail\" data-kid=\"1-3-1-3-2-3-1\" style=\"color:#c9a65a;width:16px;height:16px;font-size:16px\">\n                        </i>\n                        events@bse.bh\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"mx-auto mt-10 max-w-[1120px] border-t border-white/10 pt-5 text-center text-[10px] text-white/40\" data-kid=\"1-3-2\">\n            © 2026 BSE Event — جميع الحقوق محفوظة لجمعية المهندسين البحرينية\n        </div>\n    </footer>\n</div>\n<script>\n    const tabButtons = document.querySelectorAll('.bse-page .tab-button');\n  const programView = document.querySelector('#program-view');\n  const requirementsView = document.querySelector('#requirements-view');\n  tabButtons.forEach((button) => {\n    button.addEventListener('click', () => {\n      const isProgram = button.dataset.tab === 'program';\n      tabButtons.forEach((item) => item.setAttribute('aria-selected', String(item === button)));\n      if (isProgram) {\n        programView.hidden = false;\n        requirementsView.hidden = true;\n      } else {\n        programView.hidden = true;\n        requirementsView.hidden = false;\n      }\n    });\n  });\n</script>\n",
