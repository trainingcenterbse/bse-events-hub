enter\" data-kid=\"1-2-3-1-1-3-2-1\">\n                                <span class=\"display-number text-[30px] font-semibold text-[var(--gold)]\" data-kid=\"1-2-3-1-1-3-2-1-1\">\n                                    01\n                                </span>\n                                <h3 class=\"font-display text-[18px] font-bold text-[var(--indigo)]\" data-kid=\"1-2-3-1-1-3-2-1-2\">\n                                    كفاءة الطاقة في المباني\n                                </h3>\n                                <p class=\"text-[14px] leading-[1.8] text-[var(--ink-mute)]\" data-kid=\"1-2-3-1-1-3-2-1-3\">\n                                    أنظمة التبريد وأكواد البناء الأخضر والتحكم الذكي في الأحمال.\n                                </p>\n                                <span aria-hidden=\"true\" class=\"icon text-[var(--navy)] ti ti-arrow-up-right transition-transform group-hover:-translate-y-1\" data-kid=\"1-2-3-1-1-3-2-1-4\">\n                                </span>\n                            </div>\n                            <div class=\"group grid gap-4 py-5 sm:grid-cols-[72px_minmax(190px,.9fr)_minmax(0,1.4fr)_24px] sm:items-center\" data-kid=\"1-2-3-1-1-3-2-2\">\n                                <span class=\"display-number text-[30px] font-semibold text-[var(--gold)]\" data-kid=\"1-2-3-1-1-3-2-2-1\">\n                                    02\n                                </span>\n                                <h3 class=\"font-display text-[18px] font-bold text-[var(--indigo)]\" data-kid=\"1-2-3-1-1-3-2-2-2\">\n                                    الطاقة المتجددة والتخزين\n                                </h3>\n                                <p class=\"text-[14px] leading-[1.8] text-[var(--ink-mute)]\" data-kid=\"1-2-3-1-1-3-2-2-3\">\n                                    المشاريع الشمسية، وتكامل الشبكة، وحلول تخزين الطاقة في المنطقة.\n                                </p>\n                                <span aria-hidden=\"true\" class=\"icon t