      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  :root {\n    --bse-indigo: #1b1938;\n    --bse-deep: #0e0c1f;\n    --bse-teal: #0e3030;\n    --bse-teal-mid: #155555;\n    --bse-lavender: #c9b4fa;\n    --bse-ink: #292827;\n    --bse-muted: #73706d;\n    --bse-faint: #9a9794;\n    --bse-soft: #fafaf8;\n    --bse-line: #e8e4dd;\n    --bse-gold: #c69a3c;\n  }\n  .bse-display { font-family: 'Cairo', 'IBM Plex Sans Arabic', sans-serif; letter-spacing: -0.035em; }\n  .bse-body { font-family: 'IBM Plex Sans Arabic', 'Cairo', sans-serif; }\n  .bse-compact { font-variant-numeric: tabular-nums; }\n  .bse-line-clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }\n  .bse-service-row:last-child { border-bottom: 0; }\n  .bse-goal-row:last-child { border-bottom: 0; }\n</style>\n<div class=\"bse-body min-h-screen bg-white text-[#292827] antialiased\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" lang=\"ar\">\n    <!-- Site header -->\n    <header class=\"border-b border-[#e8e4dd] bg-white\" data-kid=\"1-1\" data-name=\"site header\">\n        <div class=\"mx-auto flex min-h-[78px] max-w-[1120px] items-center justify-between gap-8 px-6 lg:px-0\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a class=\"flex items-center gap-3 no-underline\" data-kid=\"1-1-1-1\" data-name=\"logo and brand link\" href=\"#\">\n                <span class=\"grid size-11 place-items-center rounded-full border border-[#c69a3c]/60 bg-[#fafaf8] p-1\" data-kid=\"1-1-1-1-1\" data-name=\"logo image container\">\n                    <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"size-full rounded-full object-cover\" data-kid=\"1-1-1-1-1-1\" data-name=\"BSE logo image\" decoding=\"async\" height=\"44\" loading=\"lazy\" src=\"/api/local/images/public/favicon.png\" width=\"44\"/>\n                </span>\n                <span class=\"leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"brand name and department text container\">\n                    <span class=\"bse-display block text-[19px] font-extrabold text-[#1b1938]\" data-kid=\"1-1-1-1-2-1\" data-name=\"BSE event brand headline\">\n                        BSE Event\n                    </span>\n                    <span class=\"block text-[11px] font-medium text-[#73706d]\" data-kid=\"1-1-1-1-2-2\" data-name=\"department description text\">\n                        قسم الفعاليات والمؤتمرات والمعارض\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"hidden items-center gap-1 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"rounded-[8px] px-4 py-2 text-[14px] font-semibold text-[#292827]\" data-kid=\"1-1-1-2-1\" data-name=\"about link\" href=\"#about\">\n                    من نحن\n                </a>\n                <a class=\"rounded-[8px] px-4 py-2 text-[14px] font-semibold text-[#73706d]\" data-kid=\"1-1-1-2-2\" data-name=\"goals link\" href=\"#goals\">\n                    أهدافنا\n                </a>\n                <a class=\"rounded-[8px] px-4 py-2 text-[14px] font-semibold text-[#73706d]\" data-kid=\"1-1-1-2-3\" data-name=\"services link\" href=\"#services\">\n                    خدماتنا\n                </a>\n                <a class=\"rounded-[8px] px-4 py-2 text-[14px] font-semibold text-[#73706d]\" data-kid=\"1-1-1-2-4\" data-name=\"contact link\" href=\"#contact\">\n                    تواصل معنا\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header utility actions\">\n                <span class=\"hidden items-center gap-1.5 text-[13px] font-semibold text-[#1b1938] sm:inline-flex\" data-kid=\"1-1-1-3-1\" data-name=\"language switch toggle\">\n                    <i aria-hidden=\"true\" class=\"ti ti-world text-[16px] text-[#1b1938]\" data-kid=\"1-1-1-3-1-1\" data-name=\"world icon\">\n                    </i>\n                    English\n                </span>\n                <a class=\"inline-flex min-h-11 items-center justify-center rounded-[8px] bg-[#1b1938] px-4 text-[13px] font-bold text-white no-underline\" data-kid=\"1-1-1-3-2\" data-name=\"partner CTA button\" href=\"#contact\">\n                    كن شريكًا\n                </a>\n                <span class=\"grid size-10 place-items-center rounded-[8px] border border-[#e8e4dd] text-[20px] text-[#1b1938] lg:hidden\" data-kid=\"1-1-1-3-3\" data-name=\"mobile menu toggle\">\n                    <i aria-hidden=\"true\" class=\"ti ti-menu-2 text-[20px] text-[#1b1938]\" data-kid=\"1-1-1-3-3-1\" data-name=\"menu hamburger icon\">\n                    </i>\n                </span>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Split hero: clear color separation, no PageHero -->\n        <section class=\"grid min-h-[500px] lg:grid-cols-2\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"relative order-1 flex overflow-hidden bg-[#1b1938] px-8 py-16 text-white sm:px-14 lg:order-2 lg:px-16 lg:py-20\" data-kid=\"1-2-1-1\" data-name=\"hero details container\">\n                <div class=\"absolute inset-y-0 start-0 w-1 bg-[#c69a3c]\" data-kid=\"1-2-1-1-1\" data-name=\"accent border line\">\n                </div>\n                <div class=\"absolute -bottom-20 -start-16 size-72 rounded-full border border-white/10\" data-kid=\"1-2-1-1-2\" data-name=\"large decorative orb\">\n                </div>\n                <div class=\"absolute -bottom-10 -start-6 size-48 rounded-full border border-[#c69a3c]/20\" data-kid=\"1-2-1-1-3\" data-name=\"small decorative orb\">\n                </div>\n                <div class=\"relative my-auto max-w-[560px]\" data-kid=\"1-2-1-1-4\" data-name=\"hero content block\">\n                    <div class=\"mb-7 flex items-center gap-3 text-[12px] font-semibold tracking-[0.12em] text-[#c9b4fa]\" data-kid=\"1-2-1-1-4-1\" data-name=\"pre-headline label container\">\n                        <span class=\"h-px w-10 bg-[#c69a3c]\" data-kid=\"1-2-1-1-4-1-1\" data-name=\"label horizontal line\">\n                        </span>\n                        جمعية المهندسين البحرينية\n                    </div>\n                    <h1 class=\"bse-display max-w-[620px] text-[43px] font-extrabold leading-[1.08] text-white sm:text-[58px] lg:text-[66px]\" data-kid=\"1-2-1-1-4-2\" data-name=\"hero headline text\">\n                        نحو منصات هندسية\n                        <br data-kid=\"1-2-1-1-4-2-1\" data-name=\"headline line break\"/>\n                        <span class=\"text-[#c9b4fa]\" data-kid=\"1-2-1-1-4-2-2\" data-name=\"highlighted headline text\">\n                            تصنع أثرًا\n                        </span>\n                    </h1>\n                    <p class=\"mt-7 max-w-[500px] text-[17px] leading-[1.9] text-white/75\" data-kid=\"1-2-1-1-4-3\" data-name=\"hero description text\">\n                        نحوّل الخبرة الهندسية إلى لقاءات ومنصات وبرامج منظمة تخدم المهنة، وتربط المهندس بسوق العمل والشركاء وصنّاع القرار.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap items-center gap-4\" data-kid=\"1-2-1-1-4-4\" data-name=\"hero action container\">\n                        <a class=\"inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#c9b4fa] px-6 text-[14px] font-bold text-[#1b1938] no-underline\" data-kid=\"1-2-1-1-4-4-1\" data-name=\"learn more button\" href=\"#about\">\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-down text-[17px] text-[#1b1938]\" data-kid=\"1-2-1-1-4-4-1-1\" data-name=\"down arrow icon\">\n                            </i>\n                            تعرّف على القسم\n                        </a>\n                        <span class=\"flex items-center gap-2 border-r border-white/20 pr-4 text-[13px] text-white/65\" data-kid=\"1-2-1-1-4-4-2\" data-name=\"years of experience stat\">\n                            <span class=\"bse-display text-[26px] font-bold text-[#c69a3c]\" data-kid=\"1-2-1-1-4-4-2-1\" data-name=\"years of experience number\">\n                                +40\n                            </span>\n                            عامًا من العمل الهندسي\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"relative order-2 min-h-[330px] overflow-hidden bg-[#0e0c1f] lg:order-1 lg:min-h-[500px]\" data-kid=\"1-2-1-2\" data-name=\"hero image container\">\n                <img alt=\"فريق هندسي يناقش المخططات\" class=\"absolute inset-0 size-full object-cover\" data-kid=\"1-2-1-2-1\" data-name=\"hero background image\" decoding=\"async\" height=\"1000\" loading=\"lazy\" src=\"/api/local/images/src/assets/team-work.jpg\" width=\"1600\"/>\n                <div class=\"absolute inset-0 bg-[#0e0c1f]/35\" data-kid=\"1-2-1-2-2\" data-name=\"image overlay gradient\">\n                </div>\n                <div class=\"absolute inset-x-6 bottom-6 flex items-end justify-between border-t border-white/25 pt-4 text-white sm:inset-x-10 sm:bottom-10\" data-kid=\"1-2-1-2-3\" data-name=\"image caption container\">\n                    <span class=\"text-[12px] font-medium text-white/75\" data-kid=\"1-2-1-2-3-1\" data-name=\"image category tags\">\n                        التخطيط · التشغيل · الأثر\n                    </span>\n                    <span class=\"bse-display text-[13px] font-bold text-[#c9b4fa]\" data-kid=\"1-2-1-2-3-2\" data-name=\"image metadata year range\">\n                        BSE / 1983—2026\n                    </span>\n                </div>\n            </div>\n        </section>\n        <!-- Intro / readable two-column body -->\n        <section class=\"bg-white px-6 py-20 sm:py-24\" data-kid=\"1-2-2\" data-name=\"about section\" id=\"about\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-2-1\" data-name=\"about section content\">\n                <div class=\"mb-12 flex flex-col gap-5 border-b border-[#e8e4dd] pb-8 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-2-2-1-1\" data-name=\"about section header\">\n                    <div data-kid=\"1-2-2-1-1-1\" data-name=\"about section label and headline\">\n                        <p class=\"mb-3 text-[12px] font-bold tracking-[0.18em] text-[#c69a3c]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"about section label text\">\n                            جمعية المهندسين البحرينية\n                        </p>\n                        <h2 class=\"bse-display max-w-[700px] text-[34px] font-extrabold leading-[1.14] text-[#1b1938] sm:text-[46px]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"about section main headline\">\n                            جهة مهنية، وقسم ينفّذ الفكرة حتى أثرها\n                        </h2>\n                    </div>\n                    <span class=\"bse-display shrink-0 text-[36px] font-bold leading-none text-[#e8e4dd] sm:text-[52px]\" data-kid=\"1-2-2-1-1-2\" data-name=\"section counter badge\">\n                        01 / 04\n                    </span>\n                </div>\n                <div class=\"grid items-start gap-14 lg:grid-cols-2 lg:gap-20\" data-kid=\"1-2-2-1-2\" data-name=\"about content grid\">\n                    <div class=\"max-w-[60ch]\" data-kid=\"1-2-2-1-2-1\" data-name=\"about text content block\">\n                        <p class=\"text-[18px] leading-[1.9] text-[#292827]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"about first paragraph\">\n                            جمعية المهندسين البحرينية مؤسسة مهنية تأسست لخدمة المهندسين في مملكة البحرين، وتضم آلاف الأعضاء من مختلف التخصصات الهندسية، ويقع مقرها في الجفير. تعمل الجمعية عبر لجان فنية وأقسام متخصصة لتطوير المهنة ورفع كفاءة الكادر الهندسي الوطني.\n                        </p>\n                        <p class=\"mt-6 text-[16px] leading-[1.95] text-[#73706d]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"about second paragraph\">\n                            قسم إدارة الفعاليات والمؤتمرات والمعارض هو الجهة المسؤولة عن تخطيط وتنظيم وتنفيذ جميع المؤتمرات والمعارض والندوات والأنشطة التي تحمل اسم الجمعية. نتعامل مع كل فعالية كمشروع كامل: تحليل الجدوى، بناء البرنامج، استقطاب الرعاة والعارضين، التشغيل الميداني، ثم التقرير الختامي ومؤشرات الأثر.\n                        </p>\n                        <div class=\"mt-9 flex items-center gap-3 border-r-2 border-[#c69a3c] pr-4 text-[14px] font-semibold text-[#1b1938]\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"about callout link\">\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-left text-[18px] text-[#c69a3c]\" data-kid=\"1-2-2-1-2-1-3-1\" data-name=\"left arrow icon\">\n                            </i>\n                            أربع فئات، ومسارات تعامل واضحة لكل شريك وحاضر\n                        </div>\n                    </div>\n                    <div class=\"relative min-h-[410px]\" data-kid=\"1-2-2-1-2-2\" data-name=\"about visual column\">\n                        <div class=\"absolute -inset-4 rounded-[12px] bg-[#fafaf8]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"background visual offset shape\">\n                        </div>\n                        <div class=\"relative grid h-full gap-4 sm:grid-cols-[1.15fr_0.85fr]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"feature visual content grid\">\n                            <div class=\"relative min-h-[300px] overflow-hidden rounded-[12px] bg-[#1b1938] sm:min-h-[410px]\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"feature image card\">\n                                <img alt=\"قاعة مؤتمر هندسي في البحرين\" class=\"absolute inset-0 size-full object-cover\" data-kid=\"1-2-2-1-2-2-2-1-1\" data-name=\"feature section background image\" decoding=\"async\" height=\"1088\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-conference.jpg\" width=\"1920\"/>\n                                <div class=\"absolute inset-0 bg-[#1b1938]/45\" data-kid=\"1-2-2-1-2-2-2-1-2\" data-name=\"feature image overlay\">\n                                </div>\n                                <div class=\"absolute inset-x-5 bottom-5 text-white\" data-kid=\"1-2-2-1-2-2-2-1-3\" data-name=\"feature image caption\">\n                                    <p class=\"text-[11px] tracking-[0.14em] text-[#c9b4fa]\" data-kid=\"1-2-2-1-2-2-2-1-3-1\" data-name=\"feature image category tag\">\n                                        DELIVERY ARM\n                                    </p>\n                                    <p class=\"bse-display mt-1 text-[20px] font-bold\" data-kid=\"1-2-2-1-2-2-2-1-3-2\" data-name=\"feature image title\">\n                                        من الفكرة إلى التقرير الختامي\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex flex-col justify-between rounded-[12px] bg-[#fafaf8] p-5\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"feature highlight card\">\n                                <div data-kid=\"1-2-2-1-2-2-2-2-1\" data-name=\"highlight content block\">\n                                    <p class=\"text-[11px] font-bold tracking-[0.15em] text-[#c69a3c]\" data-kid=\"1-2-2-1-2-2-2-2-1-1\" data-name=\"highlight label text\">\n                                        منذ 1983\n                                    </p>\n                                    <p class=\"bse-display mt-2 text-[35px] font-extrabold leading-none text-[#1b1938]\" data-kid=\"1-2-2-1-2-2-2-2-1-2\" data-name=\"highlight number\">\n                                        43\n                                    </p>\n                                    <p class=\"mt-2 text-[13px] leading-7 text-[#73706d]\" data-kid=\"1-2-2-1-2-2-2-2-1-3\" data-name=\"highlight description text\">\n                                        عامًا من بناء المنصات المهنية في المملكة.\n                                    </p>\n                                </div>\n                                <div class=\"border-t border-[#e8e4dd] pt-4\" data-kid=\"1-2-2-1-2-2-2-2-2\" data-name=\"highlight card footer\">\n                                    <p class=\"text-[12px] leading-7 text-[#73706d]\" data-kid=\"1-2-2-1-2-2-2-2-2-1\" data-name=\"highlight footer text\">\n                                        نخدم الرعاة، الحضور، العارضين، وشركاء التنظيم عبر باقات ومسارات مخصصة.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Vision / mission / values: solid surfaces, not glass -->\n        <section class=\"bg-[#fafaf8] px-6 py-20 sm:py-24\" data-kid=\"1-2-3\" data-name=\"vision mission section\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-3-1\" data-name=\"values grid wrapper\">\n                <div class=\"mb-10 flex items-end justify-between gap-6\" data-kid=\"1-2-3-1-1\" data-name=\"section header\">\n                    <div data-kid=\"1-2-3-1-1-1\" data-name=\"section header title container\">\n                        <p class=\"mb-3 text-[12px] font-bold tracking-[0.18em] text-[#c69a3c]\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"values section label\">\n                            مرجعنا في كل قرار\n                        </p>\n                        <h2 class=\"bse-display text-[32px] font-extrabold text-[#1b1938] sm:text-[42px]\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"values main headline\">\n                            رؤيتنا، رسالتنا، قيمنا\n                        </h2>\n                    </div>\n                    <span class=\"hidden h-px w-32 bg-[#c69a3c] sm:block\" data-kid=\"1-2-3-1-1-2\" data-name=\"decorative horizontal line\">\n                    </span>\n                </div>\n                <div class=\"grid gap-4 md:grid-cols-3\" data-kid=\"1-2-3-1-2\" data-name=\"values article grid\">\n                    <article class=\"min-h-[260px] rounded-[12px] border border-[#e8e4dd] bg-white p-7\" data-kid=\"1-2-3-1-2-1\" data-name=\"vision article\">\n                        <div class=\"mb-10 flex size-11 items-center justify-center rounded-[8px] bg-[#1b1938]/8\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"vision icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-eye text-[23px] text-[#1b1938]\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"eye icon\">\n                            </i>\n                        </div>\n                        <h3 class=\"bse-display text-[24px] font-bold text-[#1b1938]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"vision title\">\n                            رؤيتنا\n                        </h3>\n                        <p class=\"mt-3 text-[15px] leading-[1.9] text-[#73706d]\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"vision description\">\n                            أن تكون البحرين مركزًا خليجيًا معتمدًا للمؤتمرات والمعارض الهندسية المتخصصة.\n                        </p>\n                    </article>\n                    <article class=\"min-h-[260px] rounded-[12px] border border-[#e8e4dd] bg-[#fafaf8] p-7\" data-kid=\"1-2-3-1-2-2\" data-name=\"mission article\">\n                        <div class=\"mb-10 flex size-11 items-center justify-center rounded-[8px] bg-[#1b1938]/8\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"mission icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-target-arrow text-[23px] text-[#1b1938]\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"target icon\">\n                            </i>\n                        </div>\n                        <h3 class=\"bse-display text-[24px] font-bold text-[#1b1938]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"mission title\">\n                            رسالتنا\n                        </h3>\n                        <p class=\"mt-3 text-[15px] leading-[1.9] text-[#73706d]\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"mission description\">\n                            تنظيم فعاليات هندسية ذات أثر قابل للقياس تخدم المهنة والاقتصاد الوطني وتربط المهندس بسوق العمل.\n                        </p>\n                    </article>\n                    <article class=\"min-h-[260px] rounded-[12px] border border-[#bba7e9] bg-[#c9b4fa]/35 p-7\" data-kid=\"1-2-3-1-2-3\" data-name=\"values article\">\n                        <div class=\"mb-10 flex size-11 items-center justify-center rounded-[8px] bg-white/70\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"values icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-shield-check text-[23px] text-[#1b1938]\" data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"shield icon\">\n                            </i>\n                        </div>\n                        <h3 class=\"bse-display text-[24px] font-bold text-[#1b1938]\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"values title\">\n                            قيمنا\n                        </h3>\n                        <p class=\"mt-3 text-[15px] leading-[1.9] text-[#292827]\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"values description\">\n                            المهنية، الشفافية مع الرعاة والشركاء، الجودة في التنفيذ، والاستدامة في اختيار الموضوعات والموردين.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <!-- Goals: real sequence, wide rows, gold dividers -->\n        <section class=\"bg-[#1b1938] px-6 py-20 text-white sm:py-24\" data-kid=\"1-2-4\" data-name=\"strategic goals section\" id=\"goals\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-4-1\" data-name=\"goals content wrapper\">\n                <div class=\"flex flex-col gap-4 border-b border-white/15 pb-10 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-2-4-1-1\" data-name=\"goals header\">\n                    <div data-kid=\"1-2-4-1-1-1\" data-name=\"goals label and headline container\">\n                        <p class=\"mb-3 text-[12px] font-bold tracking-[0.18em] text-[#c9b4fa]\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"goals section label\">\n                            الأهداف الاستراتيجية\n                        </p>\n                        <h2 class=\"bse-display text-[34px] font-extrabold leading-tight text-white sm:text-[48px]\" data-kid=\"1-2-4-1-1-1-2\" data-name=\"goals section headline\">\n                            أربعة أهداف تحكم ما نبنيه\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[300px] text-[14px] leading-7 text-white/60\" data-kid=\"1-2-4-1-1-2\" data-name=\"goals summary paragraph\">\n                        نختار الموضوعات، ونصمم البرامج، ونقيس النتائج وفق هذه الأولويات الفعلية.\n                    </p>\n                </div>\n                <div class=\"mt-2\" data-kid=\"1-2-4-1-2\" data-name=\"goals list\">\n                    <article class=\"bse-goal-row grid gap-5 border-b border-[#c69a3c]/70 py-8 sm:grid-cols-[110px_minmax(0,0.9fr)_minmax(0,1.1fr)] sm:items-center sm:gap-8\" data-kid=\"1-2-4-1-2-1\" data-name=\"first goal article\">\n                        <span class=\"bse-display text-[48px] font-bold leading-none text-[#c69a3c]\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"goal index 01\">\n                            01\n                        </span>\n                        <h3 class=\"bse-display text-[22px] font-bold text-white sm:text-[25px]\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"goal title\">\n                            منصة وطنية للمعرفة الهندسية\n                        </h3>\n                        <p class=\"text-[15px] leading-[1.85] text-white/65\" data-kid=\"1-2-4-1-2-1-3\" data-name=\"goal description\">\n                            أن يكون القسم الجهة الأولى في المملكة لتنظيم المؤتمرات والمعارض الهندسية المتخصصة بمعايير دولية.\n                        </p>\n                    </article>\n                    <article class=\"bse-goal-row grid gap-5 border-b border-[#c69a3c]/70 py-8 sm:grid-cols-[110px_minmax(0,0.9fr)_minmax(0,1.1fr)] sm:items-center sm:gap-8\" data-kid=\"1-2-4-1-2-2\" data-name=\"second goal article\">\n                        <span class=\"bse-display text-[48px] font-bold leading-none text-[#c69a3c]\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"goal index 02\">\n                            02\n                        </span>\n                        <h3 class=\"bse-display text-[22px] font-bold text-white sm:text-[25px]\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"goal title\">\n                            ربط الصناعة بالمهنة\n                        </h3>\n                        <p class=\"text-[15px] leading-[1.85] text-white/65\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"goal description\">\n                            بناء جسور مستدامة بين الشركات والمهندسين والجهات الحكومية عبر برامج فنية وفرص تواصل حقيقية.\n                        </p>\n                    </article>\n                    <article class=\"bse-goal-row grid gap-5 border-b border-[#c69a3c]/70 py-8 sm:grid-cols-[110px_minmax(0,0.9fr)_minmax(0,1.1fr)] sm:items-center sm:gap-8\" data-kid=\"1-2-4-1-2-3\" data-name=\"third goal article\">\n                        <span class=\"bse-display text-[48px] font-bold leading-none text-[#c69a3c]\" data-kid=\"1-2-4-1-2-3-1\" data-name=\"goal index 03\">\n                            03\n                        </span>\n                        <h3 class=\"bse-display text-[22px] font-bold text-white sm:text-[25px]\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"goal title\">\n                            تمكين المهندس البحريني\n                        </h3>\n                        <p class=\"text-[15px] leading-[1.85] text-white/65\" data-kid=\"1-2-4-1-2-3-3\" data-name=\"goal description\">\n                            توفير محتوى تطويري وفرص ظهور مهني للمهندسين الشباب والخريجين ضمن كل فعالية ننظمها.\n                        </p>\n                    </article>\n                    <article class=\"bse-goal-row grid gap-5 py-8 sm:grid-cols-[110px_minmax(0,0.9fr)_minmax(0,1.1fr)] sm:items-center sm:gap-8\" data-kid=\"1-2-4-1-2-4\" data-name=\"fourth goal article\">\n                        <span class=\"bse-display text-[48px] font-bold leading-none text-[#c69a3c]\" data-kid=\"1-2-4-1-2-4-1\" data-name=\"goal index 04\">\n                            04\n                        </span>\n                        <h3 class=\"bse-display text-[22px] font-bold text-white sm:text-[25px]\" data-kid=\"1-2-4-1-2-4-2\" data-name=\"goal title\">\n                            استدامة الأثر\n                        </h3>\n                        <p class=\"text-[15px] leading-[1.85] text-white/65\" data-kid=\"1-2-4-1-2-4-3\" data-name=\"goal description\">\n                            قياس أثر كل فعالية وتوثيقه في تقارير واضحة للشركاء والرعاة، وتطوير النسخ القادمة بناءً عليه.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <!-- Services matrix + supporting image -->\n        <section class=\"bg-white px-6 py-20 sm:py-24\" data-kid=\"1-2-5\" data-name=\"services section\" id=\"services\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-5-1\" data-name=\"services content wrapper\">\n                <div class=\"mb-12 max-w-[670px]\" data-kid=\"1-2-5-1-1\" data-name=\"services header block\">\n                    <p class=\"mb-3 text-[12px] font-bold tracking-[0.18em] text-[#c69a3c]\" data-kid=\"1-2-5-1-1-1\" data-name=\"services label\">\n                        الخدمات التنفيذية\n                    </p>\n                    <h2 class=\"bse-display text-[34px] font-extrabold leading-[1.15] text-[#1b1938] sm:text-[48px]\" data-kid=\"1-2-5-1-1-2\" data-name=\"services headline\">\n                        ما نقدمه بالتفصيل\n                    </h2>\n                    <p class=\"mt-4 text-[16px] leading-8 text-[#73706d]\" data-kid=\"1-2-5-1-1-3\" data-name=\"services description\">\n                        فريق واحد ومسار واضح لكل مرحلة من مراحل الفعالية، من التخطيط إلى التغطية والتقرير.\n                    </p>\n                </div>\n                <div class=\"grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.72fr)] lg:gap-16\" data-kid=\"1-2-5-1-2\" data-name=\"services matrix container\">\n                    <div class=\"border-t-2 border-[#1b1938]\" data-kid=\"1-2-5-1-2-1\" data-name=\"services list column\">\n                        <div class=\"bse-service-row grid grid-cols-[42px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] items-start gap-4 border-b border-[#e8e4dd] py-5 sm:grid-cols-[48px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] sm:gap-5\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"event management service item\">\n                            <span class=\"grid size-9 place-items-center rounded-[8px] bg-[#1b1938] text-white\" data-kid=\"1-2-5-1-2-1-1-1\" data-name=\"event icon container\">\n                                <i aria-hidden=\"true\" class=\"ti ti-calendar-event text-[18px] text-white\" data-kid=\"1-2-5-1-2-1-1-1-1\" data-name=\"calendar icon\">\n                                </i>\n                            </span>\n                            <h3 class=\"bse-display text-[16px] font-bold text-[#1b1938]\" data-kid=\"1-2-5-1-2-1-1-2\" data-name=\"event management title\">\n                                تنظيم وإدارة الفعاليات\n                            </h3>\n                            <p class=\"text-[13px] leading-6 text-[#73706d]\" data-kid=\"1-2-5-1-2-1-1-3\" data-name=\"event management description\">\n                                إدارة كاملة للفعالية من الفكرة إلى التقرير الختامي: الجدول الزمني، الموقع، التسجيل، والتشغيل اليومي.\n                            </p>\n                            <span class=\"hidden rounded-full bg-[#c9b4fa]/50 px-2.5 py-1 text-[10px] font-bold text-[#1b1938] sm:inline-flex\" data-kid=\"1-2-5-1-2-1-1-4\" data-name=\"event management tag\">\n                                التشغيل\n                            </span>\n                        </div>\n                        <div class=\"bse-service-row grid grid-cols-[42px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] items-start gap-4 border-b border-[#e8e4dd] py-5 sm:grid-cols-[48px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] sm:gap-5\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"scientific programs service item\">\n                            <span class=\"grid size-9 place-items-center rounded-[8px] bg-[#1b1938] text-white\" data-kid=\"1-2-5-1-2-1-2-1\" data-name=\"scientific programs icon container\">\n                                <i aria-hidden=\"true\" class=\"ti ti-presentation text-[18px] text-white\" data-kid=\"1-2-5-1-2-1-2-1-1\" data-name=\"presentation icon\">\n                                </i>\n                            </span>\n                            <h3 class=\"bse-display text-[16px] font-bold text-[#1b1938]\" data-kid=\"1-2-5-1-2-1-2-2\" data-name=\"scientific programs title\">\n                                المؤتمرات والبرامج العلمية\n                            </h3>\n                            <p class=\"text-[13px] leading-6 text-[#73706d]\" data-kid=\"1-2-5-1-2-1-2-3\" data-name=\"scientific programs description\">\n                                بناء البرنامج العلمي، ولجان التحكيم، واستقطاب المتحدثين، وإدارة الأوراق الفنية المحكّمة.\n                            </p>\n                            <span class=\"hidden rounded-full bg-[#c9b4fa]/50 px-2.5 py-1 text-[10px] font-bold text-[#1b1938] sm:inline-flex\" data-kid=\"1-2-5-1-2-1-2-4\" data-name=\"scientific programs tag\">\n                                المحتوى\n                            </span>\n                        </div>\n                        <div class=\"bse-service-row grid grid-cols-[42px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] items-start gap-4 border-b border-[#e8e4dd] py-5 sm:grid-cols-[48px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] sm:gap-5\" data-kid=\"1-2-5-1-2-1-3\" data-name=\"exhibitions service item\">\n                            <span class=\"grid size-9 place-items-center rounded-[8px] bg-[#1b1938] text-white\" data-kid=\"1-2-5-1-2-1-3-1\" data-name=\"exhibitions icon container\">\n                                <i aria-hidden=\"true\" class=\"ti ti-building-store text-[18px] text-white\" data-kid=\"1-2-5-1-2-1-3-1-1\" data-name=\"building icon\">\n                                </i>\n                            </span>\n                            <h3 class=\"bse-display text-[16px] font-bold text-[#1b1938]\" data-kid=\"1-2-5-1-2-1-3-2\" data-name=\"exhibitions title\">\n                                المعارض ومساحات العرض\n                            </h3>\n                            <p class=\"text-[13px] leading-6 text-[#73706d]\" data-kid=\"1-2-5-1-2-1-3-3\" data-name=\"exhibitions description\">\n                                تصميم مخطط الأرضية، وبيع وإدارة الأجنحة، وتنسيق المقاولين والتشغيل الفني للمعرض.\n                            </p>\n                            <span class=\"hidden rounded-full bg-[#c9b4fa]/50 px-2.5 py-1 text-[10px] font-bold text-[#1b1938] sm:inline-flex\" data-kid=\"1-2-5-1-2-1-3-4\" data-name=\"exhibitions tag\">\n                                المعارض\n                            </span>\n                        </div>\n                        <div class=\"bse-service-row grid grid-cols-[42px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] items-start gap-4 border-b border-[#e8e4dd] py-5 sm:grid-cols-[48px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] sm:gap-5\" data-kid=\"1-2-5-1-2-1-4\" data-name=\"partnerships service item\">\n                            <span class=\"grid size-9 place-items-center rounded-[8px] bg-[#1b1938] text-white\" data-kid=\"1-2-5-1-2-1-4-1\" data-name=\"partnerships icon container\">\n                                <i aria-hidden=\"true\" class=\"ti ti-handshake text-[18px] text-white\" data-kid=\"1-2-5-1-2-1-4-1-1\" data-name=\"handshake icon\">\n                                </i>\n                            </span>\n                            <h3 class=\"bse-display text-[16px] font-bold text-[#1b1938]\" data-kid=\"1-2-5-1-2-1-4-2\" data-name=\"partnerships title\">\n                                الرعايات والشراكات\n                            </h3>\n                            <p class=\"text-[13px] leading-6 text-[#73706d]\" data-kid=\"1-2-5-1-2-1-4-3\" data-name=\"partnerships description\">\n                                باقات رعاية مصممة حسب أهداف الشريك، مع تقارير عائد ظهور واضحة بعد كل فعالية.\n                            </p>\n                            <span class=\"hidden rounded-full bg-[#c9b4fa]/50 px-2.5 py-1 text-[10px] font-bold text-[#1b1938] sm:inline-flex\" data-kid=\"1-2-5-1-2-1-4-4\" data-name=\"partnerships tag\">\n                                الشراكات\n                            </span>\n                        </div>\n                        <div class=\"bse-service-row grid grid-cols-[42px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] items-start gap-4 border-b border-[#e8e4dd] py-5 sm:grid-cols-[48px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] sm:gap-5\" data-kid=\"1-2-5-1-2-1-5\" data-name=\"attendance service item\">\n                            <span class=\"grid size-9 place-items-center rounded-[8px] bg-[#1b1938] text-white\" data-kid=\"1-2-5-1-2-1-5-1\" data-name=\"attendance icon container\">\n                                <i aria-hidden=\"true\" class=\"ti ti-users text-[18px] text-white\" data-kid=\"1-2-5-1-2-1-5-1-1\" data-name=\"users icon\">\n                                </i>\n                            </span>\n                            <h3 class=\"bse-display text-[16px] font-bold text-[#1b1938]\" data-kid=\"1-2-5-1-2-1-5-2\" data-name=\"attendance title\">\n                                خدمة الحضور والتسجيل\n                            </h3>\n                            <p class=\"text-[13px] leading-6 text-[#73706d]\" data-kid=\"1-2-5-1-2-1-5-3\" data-name=\"attendance description\">\n                                أنظمة تسجيل رقمية، وشارات، ومسارات دخول سلسة، ودعم مباشر للحضور طوال أيام الفعالية.\n                            </p>\n                            <span class=\"hidden rounded-full bg-[#c9b4fa]/50 px-2.5 py-1 text-[10px] font-bold text-[#1b1938] sm:inline-flex\" data-kid=\"1-2-5-1-2-1-5-4\" data-name=\"attendance tag\">\n                                الحضور\n                            </span>\n                        </div>\n                        <div class=\"bse-service-row grid grid-cols-[42px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] items-start gap-4 border-b border-[#e8e4dd] py-5 sm:grid-cols-[48px_minmax(0,0.75fr)_minmax(0,1.25fr)_auto] sm:gap-5\" data-kid=\"1-2-5-1-2-1-6\" data-name=\"media service item\">\n                            <span class=\"grid size-9 place-items-center rounded-[8px] bg-[#1b1938] text-white\" data-kid=\"1-2-5-1-2-1-6-1\" data-name=\"media icon container\">\n                                <i aria-hidden=\"true\" class=\"ti ti-speakerphone text-[18px] text-white\" data-kid=\"1-2-5-1-2-1-6-1-1\" data-name=\"megaphone icon\">\n                                </i>\n                            </span>\n                            <h3 class=\"bse-display text-[16px] font-bold text-[#1b1938]\" data-kid=\"1-2-5-1-2-1-6-2\" data-name=\"media title\">\n                                التسويق والتغطية الإعلامية\n                            </h3>\n                            <p class=\"text-[13px] leading-6 text-[#73706d]\" data-kid=\"1-2-5-1-2-1-6-3\" data-name=\"media description\">\n                                حملات رقمية، وعلاقات إعلامية محلية وخليجية، وإنتاج محتوى بصري احترافي للفعالية.\n                            </p>\n                            <span class=\"hidden rounded-full bg-[#c9b4fa]/50 px-2.5 py-1 text-[10px] font-bold text-[#1b1938] sm:inline-flex\" data-kid=\"1-2-5-1-2-1-6-4\" data-name=\"media tag\">\n                                الإعلام\n                            </span>\n                        </div>\n                    </div>\n                    <aside class=\"relative overflow-hidden rounded-[12px] bg-[#0e0c1f] lg:sticky lg:top-6\" data-kid=\"1-2-5-1-2-2\" data-name=\"services featured image container\">\n                        <img alt=\"ندوة فنية ينظمها قسم الفعاليات\" class=\"h-[270px] w-full object-cover opacity-90 sm:h-[340px]\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"featured image\" decoding=\"async\" height=\"1008\" loading=\"lazy\" src=\"/api/local/images/src/assets/seminar.jpg\" width=\"1600\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#0e0c1f] via-[#0e0c1f]/30 to-transparent\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"featured image overlay\">\n                        </div>\n                        <div class=\"absolute inset-x-6 bottom-6 text-white\" data-kid=\"1-2-5-1-2-2-3\" data-name=\"featured content container\">\n                            <p class=\"text-[11px] font-bold tracking-[0.18em] text-[#c9b4fa]\" data-kid=\"1-2-5-1-2-2-3-1\" data-name=\"featured subtitle\">\n                                ONE TEAM / SIX CAPABILITIES\n                            </p>\n                            <h3 class=\"bse-display mt-2 text-[26px] font-bold leading-tight\" data-kid=\"1-2-5-1-2-2-3-2\" data-name=\"featured title\">\n                                تشغيل واضح.\n                                <br data-kid=\"1-2-5-1-2-2-3-2-1\" data-name=\"title line break\"/>\n                                تجربة أفضل.\n                            </h3>\n                            <p class=\"mt-3 text-[13px] leading-6 text-white/65\" data-kid=\"1-2-5-1-2-2-3-3\" data-name=\"featured description\">\n                                كل خدمة مصممة لتزيل التعقيد عن الشريك، وتمنح الحاضر تجربة منظمة.\n                            </p>\n                        </div>\n                    </aside>\n                </div>\n            </div>\n        </section>\n        <!-- Final values, direct rendering (no count-up) -->\n        <section class=\"border-y border-[#3f3a52] bg-[#0e0c1f] px-6 py-10 text-white sm:py-12\" data-kid=\"1-2-6\" data-name=\"stats ticker section\">\n            <div class=\"mx-auto grid max-w-[1120px] grid-cols-2 gap-y-8 sm:grid-cols-4 sm:gap-0\" data-kid=\"1-2-6-1\" data-name=\"stats container\">\n                <div class=\"border-white/15 px-5 first:ps-0 sm:border-s\" data-kid=\"1-2-6-1-1\" data-name=\"years stat block\">\n                    <p class=\"bse-compact bse-display text-[38px] font-bold text-[#c69a3c]\" data-kid=\"1-2-6-1-1-1\" data-name=\"years number\">\n                        40+\n                    </p>\n                    <p class=\"mt-2 text-[13px] text-white/60\" data-kid=\"1-2-6-1-1-2\" data-name=\"years label\">\n                        عامًا من العمل الهندسي\n                    </p>\n                </div>\n                <div class=\"border-white/15 px-5 sm:border-s\" data-kid=\"1-2-6-1-2\" data-name=\"events stat block\">\n                    <p class=\"bse-compact bse-display text-[38px] font-bold text-[#c69a3c]\" data-kid=\"1-2-6-1-2-1\" data-name=\"events number\">\n                        120+\n                    </p>\n                    <p class=\"mt-2 text-[13px] text-white/60\" data-kid=\"1-2-6-1-2-2\" data-name=\"events label\">\n                        فعالية وندوة سنويًا\n                    </p>\n                </div>\n                <div class=\"border-white/15 px-5 first:ps-0 sm:border-s\" data-kid=\"1-2-6-1-3\" data-name=\"members stat block\">\n                    <p class=\"bse-compact bse-display text-[38px] font-bold text-[#c69a3c]\" data-kid=\"1-2-6-1-3-1\" data-name=\"members number\">\n                        7K+\n                    </p>\n                    <p class=\"mt-2 text-[13px] text-white/60\" data-kid=\"1-2-6-1-3-2\" data-name=\"members label\">\n                        عضو ومنتسب\n                    </p>\n                </div>\n                <div class=\"px-5 sm:pe-0\" data-kid=\"1-2-6-1-4\" data-name=\"partners stat block\">\n                    <p class=\"bse-compact bse-display text-[38px] font-bold text-[#c69a3c]\" data-kid=\"1-2-6-1-4-1\" data-name=\"partners number\">\n                        25+\n                    </p>\n                    <p class=\"mt-2 text-[13px] text-white/60\" data-kid=\"1-2-6-1-4-2\" data-name=\"partners label\">\n                        شريك وراعٍ\n                    </p>\n                </div>\n            </div>\n        </section>\n        <!-- One closing CTA -->\n        <section class=\"bg-[#0e3030] px-6 py-20 text-white sm:py-28\" data-kid=\"1-2-7\" data-name=\"contact CTA section\" id=\"contact\">\n            <div class=\"mx-auto flex max-w-[920px] flex-col items-start justify-between gap-9 sm:flex-row sm:items-end\" data-kid=\"1-2-7-1\" data-name=\"contact content wrapper\">\n                <div data-kid=\"1-2-7-1-1\" data-name=\"contact text content\">\n                    <p class=\"mb-4 text-[12px] font-bold tracking-[0.18em] text-[#c9b4fa]\" data-kid=\"1-2-7-1-1-1\" data-name=\"contact label\">\n                        لنبدأ من احتياجك\n                    </p>\n                    <h2 class=\"bse-display max-w-[650px] text-[35px] font-extrabold leading-[1.15] text-white sm:text-[50px]\" data-kid=\"1-2-7-1-1-2\" data-name=\"contact headline\">\n                        نحوّل الخبرة الهندسية إلى تجربة منظمة\n                    </h2>\n                    <p class=\"mt-5 max-w-[560px] text-[16px] leading-8 text-white/65\" data-kid=\"1-2-7-1-1-3\" data-name=\"contact description\">\n                        شاركنا فكرة الفعالية أو هدف الشراكة، وسيصلك المسار الأنسب من فريق القسم.\n                    </p>\n                </div>\n                <a class=\"inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-[8px] bg-white px-6 text-[14px] font-bold text-[#0e3030] no-underline\" data-kid=\"1-2-7-1-2\" data-name=\"contact action button\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-left text-[18px] text-[#0e3030]\" data-kid=\"1-2-7-1-2-1\" data-name=\"left arrow icon\">\n                    </i>\n                    تواصل مع فريقنا\n                </a>\n            </div>\n        </section>\n    </main>\n    <!-- Concise footer -->\n    <footer class=\"bg-[#0e3030] px-6 pb-8 text-white\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto flex max-w-[1120px] flex-col gap-5 border-t border-white/15 pt-7 text-[12px] text-white/55 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1\" data-name=\"footer content container\">\n            <span data-kid=\"1-3-1-1\" data-name=\"copyright text\">\n                © 2026 BSE Event — جمعية المهندسين البحرينية\n            </span>\n            <span class=\"flex items-center gap-4\" data-kid=\"1-3-1-2\" data-name=\"footer navigation links\">\n                <a class=\"text-white/65 no-underline\" data-kid=\"1-3-1-2-1\" data-name=\"footer about link\" href=\"#about\">\n                    من نحن\n                </a>\n                <a class=\"text-white/65 no-underline\" data-kid=\"1-3-1-2-2\" data-name=\"footer services link\" href=\"#services\">\n                    الخدمات\n                </a>\n                <a class=\"text-white/65 no-underline\" data-kid=\"1-3-1-2-3\" data-name=\"footer contact link\" href=\"#contact\">\n                    تواصل\n                </a>\n            </span>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-09-01T07:16:36.199921+00:00",
