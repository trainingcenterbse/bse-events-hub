                 <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-4-1-2-4-1\">\n                                <span aria-hidden=\"true\" class=\"icon-sm ti ti-calendar-event text-[var(--gold-soft)]\" data-kid=\"1-2-1-4-1-2-4-1-1\">\n                                </span>\n                                <b data-kid=\"1-2-1-4-1-2-4-1-2\" dir=\"ltr\">\n                                    2025\n                                </b>\n                            </span>\n                            <span class=\"text-white/35\" data-kid=\"1-2-1-4-1-2-4-2\">\n                                ·\n                            </span>\n                            <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-4-1-2-4-3\">\n                                <span aria-hidden=\"true\" class=\"icon-sm ti ti-clock-hour-4 text-[var(--gold-soft)]\" data-kid=\"1-2-1-4-1-2-4-3-1\">\n                                </span>\n                                3 أيام\n                            </span>\n                            <span class=\"text-white/35\" data-kid=\"1-2-1-4-1-2-4-4\">\n                                ·\n                            </span>\n                            <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-4-1-2-4-5\">\n                                <span aria-hidden=\"true\" class=\"icon-sm ti ti-users text-[var(--gold-soft)]\" data-kid=\"1-2-1-4-1-2-4-5-1\">\n                                </span>\n                                1200+ حاضر متوقع\n                            </span>\n                        </div>\n                        <div class=\"mt-8 flex flex-wrap gap-3\" data-kid=\"1-2-1-4-1-2-5\">\n                            <a class=\"inline-flex min-h-12 items-center gap-2 rounded-lg bg-[var(--gold)] px-6 text-[14px] font-bold text-[var(--indigo-deep)] shadow-[0_10px_25px_rgba(217,168,58,.24)] hover:bg-[var(--gold-soft)]\" data-kid=\"1-2-1-4-1-2-5-1\" href=\"https://bse.bh/ar/conferences/\" rel=\"noreferrer\" target=\"_blank\">\n                                <span aria-hidden=\"true\" class=\"icon-sm ti ti-file-download\" data-kid=\"1-2-1-4-1-2-5-1-1\">\n                                </span>\n                                عرض البروشور\n                            </a>\n                            <a class=\"inline-flex min-h-12 items-center gap-2 rounded-lg border border-white/55 bg-white/5 px-6 text-[14px] font-bold text-white hover:bg-white/12\" data-kid=\"1-2-1-4-1-2-5-2\" href=\"#contact\">\n                                <span aria-hidden=\"true\" class=\"icon-sm ti ti-arrow-up-right\" data-kid=\"1-2-1-4-1-2-5-2-1\">\n                                </span>\n                                سجّل اهتمامك\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <nav aria-label=\"أقسام المؤتمر\" class=\"hairline-shadow sticky top-[78px] z-40 border-b border-[var(--hairline)] bg-white/95 backdrop-blur-md\" data-kid=\"1-2-2\">\n            <div class=\"mx-auto flex max-w-[1120px] items-center gap-1 overflow-x-auto px-6\" data-kid=\"1-2-2-1\">\n                <a class=\"anchor-active no-wrap border-b-2 px-4 py-4 text-[13px] font-bold\" data-kid=\"1-2-2-1-1\" href=\"#overview\">\n                    نظرة عامة\n                </a>\n                <a class=\"anchor-idle no-wrap border-b-2 px-4 py-4 text-[13px] font-bold hover:text-[var(--navy)]\" data-kid=\"1-2-2-1-2\" href=\"#tracks\">\n                    المسارات الفنية\n                </a>\n                <a class=\"anchor-idle no-wrap border-b-2 px-4 py-4 text-[13px] font-bold hover:text-[var(--navy)]\" data-kid=\"1-2-2-1-3\" href=\"#program\">\n                    البرنامج\n                </a>\n                <a class=\"anchor-idle no-wrap border-b-2 px-4 py-4 text-[13px] font-bold hover:text-[var(--navy)]\" data-kid=\"1-2-2-1-4\" href=\"#speakers\">\n                    المتحدثون\n                </a>\n                <a class=\"anchor-idle no-wrap border-b-2 px-4 py-4 text-[13px] font-bold hover:text-[var(--navy)]\" data-kid=\"1-2-2-1-5\" href=\"#location\">\n                    الموقع\n                </a>\n                <span class=\"ms-auto hidden items-center gap-2 text-[11px] font-semibold text-[var(--ink-faint)] lg:flex\" data-kid=\"1-2-2-1-6\">\n                    <span aria-hidden=\"true\" class=\"icon-sm ti ti-bookmark text-[var(--gold)]\" data-kid=\"1-2-2-1-6-1\">\n                    </span>\n                    مؤتمر ومعرض متخصص\n                </span>\n            </div>\n        </nav>\n        <section class=\"bg-[var(--canvas)] py-16 sm:py-20\" data-kid=\"1-2-3\" id=\"overview\">\n            <div class=\"mx-auto grid max-w-[1120px] gap-14 px-6 lg:grid-cols-[minmax(0,1.75fr)_minmax(300px,.85fr)] lg:gap-16\" data-kid=\"1-2-3-1\">\n                <div class=\"min-w-0\" data-kid=\"1-2-3-1-1\">\n                    <div class=\"max-w-[740px]\" data-kid=\"1-2-3-1-1-1\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[.18em] text-[var(--gold)]\" data-kid=\"1-2-3-1-1-1-1\">\n                            نظرة عامة\n                        </p>\n                        <h2 class=\"arabic-heading mt-3 text-[30px] text-[var(--indigo)] sm:text-[39px]\" data-kid=\"1-2-3-1-1-1-2\">\n                            عن المؤتمر\n                        </h2>\n                        <div class=\"gold-line mt-5 h-1 w-16\" data-kid=\"1-2-3-1-1-1-3\">\n                        </div>\n                        <p class=\"mt-7 text-[16px] leading-[2] text-[var(--ink-mute)]\" data-kid=\"1-2-3-1-1-1-4\">\n                            تستضيف جمعية المهندسين البحرينية النسخة السادسة والعشرين من الملتقى الهندسي الخليجي تحت عنوان إدارة الطاقة، بالتعاون مع اتحاد المهندسين الخليجيين. يجمع الملتقى صنّاع القرار في قطاع الطاقة والمرافق مع الجامعات ومكاتب الاستشارات الهندسية.\n                        </p>\n                        <p class=\"mt-5 text-[16px] leading-[2] text-[var(--ink-mute)]\" data-kid=\"1-2-3-1-1-1-5\">\n                            يضم البرنامج العلمي أوراقاً محكّمة، ومعرضاً مصاحباً للتقنيات، وجلسات حوارية حول السياسات والتشريعات وكفاءة الاستهلاك في مباني ومصانع المنطقة.\n                        </p>\n                    </div>\n                    <div class=\"mt-12 grid grid-cols-2 border-y border-[var(--hairline)] sm:grid-cols-4\" data-kid=\"1-2-3-1-1-2\">\n                        <div class=\"border-s border-[var(--hairline)] py-5 pe-5 first:border-s-0 sm:pe-6\" data-kid=\"1-2-3-1-1-2-1\">\n                            <p class=\"display-number text-[35px] font-semibold text-[var(--navy)]\" data-kid=\"1-2-3-1-1-2-1-1\">\n                                6\n                            </p>\n                            <p class=\"mt-2 text-[12px] leading-relaxed text-[var(--ink-mute)]\" data-kid=\"1-2-3-1-1-2-1-2\">\n                                دول خليجية مشاركة\n                            </p>\n                        </div>\n                        <div class=\"border-s border-[var(--hairline)] py-5 pe-5 sm:pe-6\" data-kid=\"1-2-3-1-1-2-2\">\n                            <p class=\"display-number text-[35px] font-semibold text-[var(--navy)]\" data-kid=\"1-2-3-1-1-2-2-1\">\n                                40+\n                            </p>\n                            <p class=\"mt-2 text-[12px] leading-relaxed text-[var(--ink-mute)]\" data-kid=\"1-2-3-1-1-2-2-2\">\n                                متحدث ومتحدثة\n                            </p>\n                        </div>\n                        <div class=\"border-s border-[var(--hairline)] py-5 pe-5 sm:pe-6\" data-kid=\"1-2-3-1-1-2-3\">\n                            <p class=\"display-number text-[35px] font-semibold text-[var(--navy)]\" data-kid=\"1-2-3-1-1-2-3-1\">\n                                1200+\n                            </p>\n                            <p class=\"mt-2 text-[12px] leading-relaxed text