    "var_757b5863455f": {
      "type": "variant",
      "label": "المؤتمرات — قائمة السنوات",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.0/tabler-icons.min.css');\n  .bse-page { --navy: #0d1b46; --blue: #173f86; --blue-soft: #eaf0fb; --gold: #c99b3f; --gold-soft: #f3ead2; --teal: #0e3030; --ink: #292827; --muted: #73706d; --canvas: #ffffff; --canvas-soft: #f7f8fa; --hairline: #e3e6ec; font-family: 'IBM Plex Sans Arabic', sans-serif; color: var(--ink); }\n  .bse-page .font-display { font-family: 'Cairo', 'IBM Plex Sans Arabic', sans-serif; }\n  .bse-page .font-ui { font-family: 'Inter', 'IBM Plex Sans Arabic', sans-serif; }\n  .bse-page .font-variation { font-variation-settings: 'wght' 540; }\n  .bse-page .hero-image { object-position: center 46%; }\n  .bse-page .row-image { object-position: center; }\n  .bse-page .tab-active { background: var(--navy); color: white; box-shadow: 0 4px 12px rgba(13,27,70,.18); }\n  .bse-page .tab-idle { color: var(--muted); }\n  .bse-page .tab-idle:hover { color: var(--navy); background: var(--blue-soft); }\n  .bse-page .conference-row.is-muted { opacity: .64; }\n  .bse-page .conference-row.is-muted:hover { opacity: 1; }\n  .bse-page .conference-row[hidden] { display: none; }\n  .bse-page .icon-box { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 8px; background: var(--gold-soft); color: var(--navy); }\n  .bse-page .meta-cell + .meta-cell { border-inline-start: 1px solid var(--hairline); }\n  .bse-page .select-chevron { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--navy) 50%), linear-gradient(135deg, var(--navy) 50%, transparent 50%); background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%; background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; }\n  .bse-page .footer-link { color: rgba(255,255,255,.68); }\n  .bse-page .footer-link:hover { color: var(--gold); }\n</style>\n<div class=\"bse-page min-h-screen bg-[var(--canvas-soft)] text-[var(--ink)] antialiased\" data-kid=\"1\" dir=\"rtl\">\n    <header class=\"relative z-20 h-[76px] border-b border-[var(--hairline)] bg-white\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-full max-w-[1160px] items-center justify-between gap-8 px-6\" data-kid=\"1-1-1\">\n            <a aria-label=\"BSE Event — الرئيسية\" class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span class=\"grid size-11 place-items-center rounded-full border border-[var(--gold)] bg-white p-0.5 shadow-sm\" data-kid=\"1-1-1-1-1\">\n                    <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"size-full rounded-full object-cover\" data-kid=\"1-1-1-1-1-1\" decoding=\"async\" height=\"44\" loading=\"lazy\" src=\"/api/local/images/public/favicon.png\" width=\"44\"/>\n                </span>\n                <span class=\"flex flex-col leading-tight\" data-kid=\"1-1-1-1-2\">\n                    <span class=\"font-display text-[19px] font-extrabold tracking-[-.02em] text-[var(--blue)]\" data-kid=\"1-1-1-1-2-1\">\n                        BSE Event\n                    </span>\n                    <span class=\"mt-0.5 text-[11px] font-semibold text-[var(--muted)]\" data-kid=\"1-1-1-1-2-2\">\n                        قسم الفعاليات والمؤتمرات والمعارض\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"hidden items-center gap-1 lg:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"font-display rounded-md px-3.5 py-2 text-[14px] font-semibold text-[var(--muted)] hover:bg-[var(--blue-soft)] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-1\" href=\"#top\">\n                    الرئيسية\n                </a>\n                <a class=\"font-display rounded-md px-3.5 py-2 text-[14px] font-semibold text-[var(--muted)] hover:bg-[var(--blue-soft)] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-2\" href=\"#about\">\n                    من نحن\n                </a>\n                <a class=\"font-display rounded-md bg-[var(--blue-soft)] px-3.5 py-2 text-[14px] font-bold text-[var(--navy)]\" data-kid=\"1-1-1-2-3\" href=\"#conference-list\">\n                    المؤتمرات\n                </a>\n                <a class=\"font-display rounded-md px-3.5 py-2 text-[14px] font-semibold text-[var(--muted)] hover:bg-[var(--blue-soft)] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-4\" href=\"#events\">\n                    الفعاليات\n                </a>\n                <a class=\"font-display rounded-md px-3.5 py-2 text-[14px] font-semibold text-[var(--muted)] hover:bg-[var(--blue-soft)] hover:text-[var(--navy)]\" data-kid=\"1-1-1-2-5\" href=\"#contact\">\n                    الرعاة\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-3\">\n                <button aria-label=\"تغيير اللغة\" class=\"font-ui hidden min-h-10 items-center gap-2 rounded-md border border-[var(--hairline)] bg-white px-3.5 text-[12px] font-semibold text-[var(--navy)] sm:inline-flex\" data-kid=\"1-1-1-3-1\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-world text-[16px]\" data-kid=\"1-1-1-3-1-1\">\n                    </i>\n                    English\n                </button>\n                <a class=\"font-display inline-flex min-h-10 items-center rounded-md bg-[var(--navy)] px-4 text-[13px] font-bold text-white shadow-sm hover:bg-[var(--blue)]\" data-kid=\"1-1-1-3-2\" href=\"#contact\">\n                    كن راعياً\n                </a>\n                <button aria-label=\"فتح القائمة\" class=\"grid size-10 place-items-center rounded-md border border-[var(--hairline)] text-[var(--navy)] lg:hidden\" data-kid=\"1-1-1-3-3\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-menu-2 text-[20px]\" data-kid=\"1-1-1-3-3-1\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"relative isolate h-[410px] overflow-hidden bg-[var(--navy)]\" data-kid=\"1-2-1\">\n            <img alt=\"قاعة مؤتمر هندسي في البحرين\" class=\"hero-image absolute inset-0 size-full object-cover\" data-kid=\"1-2-1-1\" decoding=\"async\" height=\"1088\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-conference.jpg\" width=\"1920\"/>\n            <div class=\"absolute inset-0\" data-kid=\"1-2-1-2\" style=\"background: linear-gradient(90deg, rgba(8,17,45,.98) 0%, rgba(13,37,91,.88) 44%, rgba(13,27,70,.60) 100%);\">\n            </div>\n            <div class=\"absolute inset-0 opacity-25\" data-kid=\"1-2-1-3\" style=\"background: linear-gradient(115deg, transparent 0 62%, rgba(201,155,63,.28) 62.2% 62.6%, transparent 62.8% 100%);\">\n            </div>\n            <div class=\"relative mx-auto flex h-full max-w-[1160px] items-center px-6\" data-kid=\"1-2-1-4\">\n                <div aria-hidden=\"true\" class=\"absolute bottom-[-22px] left-4 font-ui text-[220px] font-semibold leading-none tracking-[-.1em] text-white/[.07]\" data-kid=\"1-2-1-4-1\" dir=\"ltr\">\n                    26\n                </div>\n                <div class=\"absolute bottom-0 left-0 right-0 h-px bg-[var(--gold)]/70\" data-kid=\"1-2-1-4-2\">\n                </div>\n                <div class=\"relative ms-auto max-w-[690px] text-right\" data-kid=\"1-2-1-4-3\">\n                    <div class=\"mb-5 flex flex-wrap items-center justify-end gap-3\" data-kid=\"1-2-1-4-3-1\">\n                        <span class=\"inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-[12px] font-semibold text-white backdrop-blur-sm\" data-kid=\"1-2-1-4-3-1-1\">\n                            <span class=\"size-1.5 rounded-full bg-[var(--gold)]\" data-kid=\"1-2-1-4-3-1-1-1\">\n                            </span>\n                            أجندة 2025\n                        </span>\n                        <span class=\"font-ui text-[11px] font-semibold uppercase tracking-[.22em] text-[var(--gold)]\" data-kid=\"1-2-1-4-3-1-2\">\n                            CONFERENCES / 01\n                        </span>\n                    </div>\n                    <h1 class=\"font-display text-[48px] font-extrabold leading-[1.08] tracking-[-.035em] text-white sm:text-[58px]\" data-kid=\"1-2-1-4-3-2\">\n                        المؤتمرات الهندسية\n                    </h1>\n                    <p class=\"mt-5 max-w-[650px] text-[17px] leading-[1.8] text-white/80\" data-kid=\"1-2-1-4-3-3\">\n                        منصات علمية تجمع الخبراء وصنّاع القرار والقطاع الهندسي حول موضوعات الطاقة والصيانة والتقنية والتآكل.\n                    </p>\n                    <div class=\"mt-7 flex flex-wrap justify-end gap-3\" data-kid=\"1-2-1-4-3-4\">\n                        <a class=\"font-display inline-flex min-h-11 items-center gap-2 rounded-md bg-[var(--gold)] px-5 text-[14px] font-bold text-[var(--navy)] shadow-sm hover:bg-[#e0b45c]\" data-kid=\"1-2-1-4-3-4-1\" href=\"#conference-list\">\n                            تصفح المؤتمرات\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-down-left text-[17px]\" data-kid=\"1-2-1-4-3-4-1-1\">\n                            </i>\n                        </a>\n                        <a class=\"font-display inline-flex min-h-11 items-center gap-2 rounded-md border border-white/35 bg-transparent px-5 text-[14px] font-bold text-white hover:bg-white/10\" data-kid=\"1-2-1-4-3-4-2\" href=\"#contact\">\n                            فرص الشراكة\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[17px]\" data-kid=\"1-2-1-4-3-4-2-1\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"أثر المؤتمرات\" class=\"border-b border-[var(--hairline)] bg-white\" data-kid=\"1-2-2\">\n            <div class=\"mx-auto grid max-w-[1160px] grid-cols-1 px-6 sm:grid-cols-3\" data-kid=\"1-2-2-1\">\n                <div class=\"flex items-center gap-5 border-b border-[var(--hairline)] py-7 sm:border-b-0 sm:border-s sm:pe-8\" data-kid=\"1-2-2-1-1\">\n                    <span class=\"font-ui text-[42px] font-semibold leading-none tracking-[-.06em] text-[var(--blue)]\" data-kid=\"1-2-2-1-1-1\" dir=\"ltr\">\n                        26\n                    </span>\n                    <span class=\"font-display text-[13px] font-semibold leading-[1.6] text-[var(--muted)]\" data-kid=\"1-2-2-1-1-2\">\n                        نسخة من\n                        <br data-kid=\"1-2-2-1-1-2-1\"/>\n                        الملتقى الخليجي\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5 border-b border-[var(--hairline)] py-7 sm:border-b-0 sm:border-s sm:px-8\" data-kid=\"1-2-2-1-2\">\n                    <span class=\"font-ui text-[42px] font-semibold leading-none tracking-[-.06em] text-[var(--blue)]\" data-kid=\"1-2-2-1-2-1\" dir=\"ltr\">\n                        150+\n                    </span>\n                    <span class=\"font-display text-[13px] font-semibold leading-[1.6] text-[var(--muted)]\" data-kid=\"1-2-2-1-2-2\">\n                        ورقة فنية\n                        <br data-kid=\"1-2-2-1-2-2-1\"/>\n                        محكّمة\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5 py-7 sm:ps-8\" data-kid=\"1-2-2-1-3\">\n                    <span class=\"font-ui text-[42px] font-semibold leading-none tracking-[-.06em] text-[var(--blue)]\" data-kid=\"1-2-2-1-3-1\" dir=\"ltr\">\n                        20+\n                    </span>\n                    <span class=\"font-display text-[13px] font-semibold leading-[1.6] te